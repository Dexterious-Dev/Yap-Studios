0; font-size: 11.5px; font-family: inherit; }\n.px-mini:hover { background: #ffffff20; color: #fff; }\n.px-recent { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 10px; }\n.px-dot { width: 20px; height: 20px; border-radius: 6px; border: 1px solid #ffffff2a; cursor: pointer; padding: 0; }\n.px-dot.big { width: 100%; height: 26px; }\n.px-dot:hover { transform: scale(1.12); box-shadow: 0 0 0 2px #fff; }\n.px-add { background: #ffffff0d !important; color: #fff; font-weight: 900; font-size: 15px; }\n.px-pal { display: grid; grid-template-columns: repeat(8, 1fr); gap: 4px; }\n.px-palbtns { margin-bottom: 8px; }\n.px-sel { padding: 5px 8px; border-radius: 8px; border: 1px solid #ffffff1a; background: #0d0e12; color: #fff; font-weight: 600; font-size: 12px; font-family: inherit; text-transform: none; letter-spacing: 0; max-width: 150px; }\n.px-lbtns { display: flex; gap: 2px; }\n.px-lbtns .px-mini { padding: 5px; }\n.px-layers { display: grid; gap: 4px; align-content: start; overflow-y: auto; flex: 1; min-height: 60px; }\n.px-layer { display: flex; align-items: center; gap: 6px; padding: 5px 6px; border-radius: 9px; border: 1px solid transparent; cursor: grab; transition: background .12s; }\n.px-layer:hover { background: #ffffff08; }\n.px-layer.on { background: color-mix(in srgb, var(--pa) 16%, transparent); border-color: color-mix(in srgb, var(--pa) 50%, transparent); }\n.px-layer.hidden-l .px-lthumb, .px-layer.hidden-l .px-lname { opacity: .45; }\n.px-dragging { opacity: .45; }\n.px-drop-before { box-shadow: 0 -2px 0 var(--pa) !important; } .px-frame.px-drop-before { box-shadow: -3px 0 0 var(--pa) !important; }\n.px-drop-after { box-shadow: 0 2px 0 var(--pa) !important; } .px-frame.px-drop-after { box-shadow: 3px 0 0 var(--pa) !important; }\n.px-eye { width: 26px; height: 26px; display: grid; place-items: center; border: 0; border-radius: 7px; background: none; color: #c4c7d0; cursor: pointer; flex: none; }\n.px-eye:hover { background: #ffffff10; }\n.px-eye.off { c