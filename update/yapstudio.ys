; width: max-content; }\n.px-seg button { border: 0; background: none; color: #a9adba; font-weight: 800; font-size: 13px; font-family: inherit; padding: 8px 14px; border-radius: 8px; cursor: pointer; }\n.px-seg button.on { color: #fff; background: var(--pa); }\n.px-exp-sz { font-size: 13px; font-weight: 800; color: #fff; }\n.px-adj { display: grid; grid-template-columns: 90px 1fr 44px; align-items: center; gap: 10px; font-size: 12.5px; font-weight: 700; color: #c9ccd6; }\n.px-adj input { accent-color: var(--pa); } .px-adj b { text-align: right; color: #fff; font-variant-numeric: tabular-nums; }\n.px-tips { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }\n.px-tip { display: grid; gap: 4px; padding: 12px; border-radius: 12px; background: #ffffff08; border: 1px solid #ffffff10; font-size: 12.5px; line-height: 1.45; color: #b9bdc8; }\n.px-tip b { color: #fff; font-size: 13px; }\n.px-mini.on { color: #fff; background: color-mix(in srgb, var(--pa) 35%, transparent); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--pa) 65%, transparent); }\n.px-hsub { font-weight: 700; letter-spacing: 0; text-transform: none; color: #6f7380; }\n.px-prevbox { display: grid; place-items: center; min-height: 70px; padding: 8px; border-radius: 10px; background: repeating-conic-gradient(#ffffff0e 0 25%, transparent 0 50%) 0 0 / 12px 12px, #0d0e12; }\n.px-prevbox.bg1 { background: #1e1f22; } .px-prevbox.bg2 { background: #f2f3f5; }\n.px-prev { display: block; image-rendering: pixelated; max-width: 100%; }\n.px-hint { font-size: 11.5px; color: #8b8f9c; margin: 4px 0 8px; line-height: 1.4; }\n.px-opts { display: flex; flex-wrap: wrap; gap: 4px; }\n.px-shades { display: grid; grid-template-columns: repeat(7, 1fr); gap: 3px; margin-top: 10px; }\n.px-shades .px-dot.mid { box-shadow: 0 0 0 2px #fff; }\n.px-anchor { display: grid; grid-template-columns: repeat(3, 14px); gap: 3px; margin: 0 6px; }\n.px-anchor button { width: 14px; height: 14px; padding: 0; b