 }\n.ys-fa-remind { padding: 12px 14px; border-radius: 14px; background: #1f2026f5; border: 1px solid color-mix(in srgb, var(--ys-accent, #ff7a45) 50%, #ffffff1f); box-shadow: 0 16px 40px #000a; font: 13px "Segoe UI", Inter, system-ui, sans-serif; color: #e8e9ee; animation: ys-fa-in .25s ease-out; }\n@keyframes ys-fa-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }\n.ys-fa-remh { display: flex; align-items: center; gap: 6px; color: var(--ys-accent, #ff9a6c); margin-bottom: 4px; } .ys-fa-remh b { color: #fff; }\n.ys-fa-remt { white-space: pre-wrap; overflow-wrap: anywhere; max-height: 120px; overflow: auto; } .ys-fa-rems { font-size: 12px; color: #8b8f9c; margin-top: 2px; }\n.ys-fa-remind .ys-fa-btns { margin-top: 8px; }\n#ys-fa-count { position: fixed; z-index: 2147483300; padding: 2px 8px; border-radius: 99px; background: #1f2026e6; border: 1px solid #ffffff1a; color: #b5bac1; font: 600 11px "Segoe UI", sans-serif; pointer-events: none; }\n.ys-fa-saved { display: grid; gap: 8px; margin-top: 10px; }\n.ys-fa-sitem { padding: 10px 12px; border-radius: 12px; background: var(--ys-card2, #2a2b32); border: 1px solid var(--ys-line, #ffffff14); }\n.ys-fa-shead { display: flex; gap: 8px; align-items: baseline; } .ys-fa-shead span { font-size: 12px; color: var(--ys-mut, #9ea3ae); }\n.ys-fa-stext { margin: 4px 0 8px; white-space: pre-wrap; overflow-wrap: anywhere; max-height: 120px; overflow: auto; font-size: 13px; }\n.ys-fa-snew { display: grid; gap: 8px; margin-top: 10px; }\n/* ---- the Extras page picker ---- */\n.ys-extras-pick { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr)); gap: 10px; margin-bottom: 14px; }\n.ys-extras-opt { display: flex; align-items: center; gap: 12px; text-align: left; padding: 12px 14px; border-radius: 12px; background: var(--ys-card); border: 1px solid var(--ys-line2); color: var(--ys-text); cursor: pointer; font: inherit; transition: border-color .15s, background .15s, transform .15s; }\n.ys-extras-opt:hover { border-color: color-mix(in srgb, var(--ys-accent) 45%, transparent); transform: translateY(-1px); }\n.ys-extras-opt.on { border-color: var(--ys-accent); background: color-mix(in srgb, var(--ys-accent) 12%, var(--ys-card)); box-shadow: 0 0 0 3px color-mix(in srgb, var(--ys-accent) 14%, transparent); }\n.ys-extras-opt:focus-visible { outline: 2px solid var(--ys-accent); outline-offset: 2px; }\n.ys-extras-ic { flex: none; width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; color: var(--ys-accent); background: color-mix(in srgb, var(--ys-accent) 14%, transparent); }\n.ys-extras-txt { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }\n.ys-extras-txt b { font-size: 14px; }\n.ys-extras-txt span { font-size: 12px; color: var(--ys-faint); line-height: 1.35; }\n.ys-extras-state { flex: none; font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 99px; color: var(--ys-faint); border: 1px solid var(--ys-line2); }\n.ys-extras-state.on { color: #fff; background: var(--ys-accent); border-color: transparent; }\n/* ---- the editor ---- */\n#yapstudio-pixel { position: fixed; inset: 0; z-index: 2147483300; display: grid; grid-template-rows: auto auto minmax(0, 1fr) auto auto; background: #0f1014; color: #e8e9ee; outline: none;\n  font: 13px Inter, "Segoe UI", system-ui, sans-serif; --pa: var(--accent, #ff6b4a); --pl: #ffffff12; --pb: #16171c; --pc: #1c1d23; animation: ys-px-in .25s ease both; }\n@keyframes ys-px-in { from { opacity: 0; transform: scale(.985); } to { opacity: 1; transform: none; } }\n#yapstudio-pixel *, #yapstudio-pixel *::before, #yapstudio-pixel *::after { box-sizing: border-box; }\n#yapstudio-pixel button { font-family: inherit; }\n:where(#yapstudio-pixel) input[type=text], :where(#yapstudio-pixel) input[type=number] { display: inline-block; margin: 0; box-shadow: none; line-height: normal; }   /* the website's own input look stays out of the editor */\n#yapstudio-pixel ::-webkit-scrollbar { width: 9px; height: 9px; } #yapstudio-pixel ::-webkit-scrollbar-thumb { background: #ffffff1c; border-radius: 9px; border: 2px solid transparent; background-clip: padding-box; }\n/* top bar: brand, menus, name, quick buttons */\n.px-top { display: flex; align-items: center; gap: 3px; padding: 6px 10px; background: linear-gradient(180deg, #1c1d24, #17181d); border-bottom: 1px solid var(--pl); overflow-x: auto; scrollbar-width: none; min-width: 0; }\n.px-brand { display: flex; align-items: center; gap: 8px; padding: 0 8px 0 2px; color: var(--pa); white-space: nowrap; flex: none; }\n.px-brand b { color: #fff; font-size: 14px; letter-spacing: -.01em; }\n.px-menus { display: flex; gap: 1px; flex: none; }\n.px-menu-btn { height: 30px; padding: 0 10px; border: 0; border-radius: 8px; background: none; color: #c4c7d0; font-weight: 600; font-size: 13px; cursor: pointer; white-space: nowrap; }\n.px-menu-btn:hover, .px-menu-btn.open { background: #ffffff14; color: #fff; }\n#yapstudio-pixel .px-name { width: 160px; padding: 6px 10px; border-radius: 9px; border: 1px solid #ffffff1a; background: #0d0e12; color: #fff; font-weight: 600; font-size: 13px; font-family: inherit; flex: none; }\n#yapstudio-pixel .px-name:focus { outline: none; border-color: var(--pa); }\n.px-sep { width: 1px; height: 22px; background: #ffffff18; margin: 0 5px; flex: none; }\n.px-flex { flex: 1; min-width: 8px; }\n.px-btn { display: inline-flex; align-items: center; gap: 6px; height: 32px; padding: 0 8px; border-radius: 9px; border: 0; background: none; color: #c4c7d0; cursor: pointer; font-weight: 600; font-size: 13px; font-family: inherit; white-space: nowrap; flex: none; transition: background .12s, color .12s, opacity .12s; }\n.px-btn:hover { background: #ffffff12; color: #fff; }\n.px-btn.on { color: #fff; background: color-mix(in srgb, var(--pa) 30%, transparent); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--pa) 60%, transparent); }\n.px-btn.dim { opacity: .38; }\n.px-export { background: var(--pa); color: #14100e; font-weight: 800; padding: 0 12px; margin-left: 4px; }\n.px-export:hover { background: var(--pa); color: #000; filter: brightness(1.1); box-shadow: 0 6px 18px color-mix(in srgb, var(--pa) 40%, transparent); }\n.px-close:hover { background: #ff4b5c26; color: #ff8a95; }\n.px-savestate { font-size: 11.5px; font-weight: 800; color: #6fd6a0; padding: 3px 9px; border-radius: 99px; background: #2fd07a18; white-space: nowrap; flex: none; margin-right: 4px; }\n.px-savestate.dirty { color: #ffc078; background: #ffa94d18; }\n/* menus */\n.px-menu { position: absolute; z-index: 8; min-width: 240px; max-height: calc(100% - 20px); overflow-y: auto; padding: 5px; border-radius: 12px; background: #202128f5; border: 1px solid #ffffff1f; box-shadow: 0 18px 50px #000b; backdrop-filter: blur(8px); animation: px-menu-in .12s ease-out both; }\n@keyframes px-menu-in { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }\n.px-menu-item { display: grid; grid-template-columns: 18px 1fr auto; align-items: center; gap: 8px; width: 100%; padding: 7px 10px 7px 8px; border: 0; border-radius: 8px; background: none; color: #e3e4ea; font-size: 13px; text-align: left; cursor: pointer; }\n.px-menu-item:hover { background: color-mix(in srgb, var(--pa) 26%, transparent); color: #fff; }\n.px-menu-item.dis { opacity: .4; pointer-events: none; }\n.px-menu-item kbd { font: 700 11px Consolas, monospace; color: #8b8f9c; }\n.px-menu-check { display: grid; place-items: center; color: var(--pa); }\n.px-menu-sep { height: 1px; background: #ffffff14; margin: 5px 6px; }\n.px-menu-head { padding: 8px 10px 4px; font-size: 10px; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; color: #7d8190; }\n/* tool options bar */\n.px-optbar { display: flex; flex-wrap: wrap; align-items: center; gap: 5px 8px; min-height: 42px; padding: 5px 12px; background: var(--pb); border-bottom: 1px solid var(--pl); min-width: 0; }\n.px-oname { display: flex; align-items: center; gap: 7px; color: var(--pa); flex: none; }\n.px-oname b { color: #fff; font-size: 13px; white-space: nowrap; }\n.px-osep { width: 1px; height: 22px; background: #ffffff16; flex: none; }\n.px-size { display: flex; align-items: center; gap: 5px; flex: none; font-size: 12px; font-weight: 700; color: #9ea3ae; }\n.px-size button { width: 24px; height: 24px; border-radius: 7px; border: 0; background: #ffffff12; color: #fff; cursor: pointer; font-weight: 900; font-size: 14px; line-height: 1; }\n.px-size button:hover { background: #ffffff22; }\n.px-size input, .px-oslider input { width: 96px; accent-color: var(--pa); }\n.px-size b, .px-oslider b { min-width: 26px; text-align: center; color: #fff; font-size: 12.5px; font-variant-numeric: tabular-nums; }\n.px-oslider { display: flex; align-items: center; gap: 6px; flex: none; font-size: 12px; font-weight: 700; color: #9ea3ae; }\n.px-oseg { display: flex; gap: 2px; padding: 2px; border-radius: 9px; background: #0d0e12; flex: none; }\n.px-oseg button { border: 0; background: none; color: #a9adba; font-weight: 700; font-size: 12px; padding: 5px 9px; border-radius: 7px; cursor: pointer; white-space: nowrap; }\n.px-oseg button:hover { color: #fff; }\n.px-oseg button.on { color: #fff; background: color-mix(in srgb, var(--pa) 70%, #000); }\n.px-chip { flex: none; white-space: nowrap; }\n.px-ohint { flex: 1 1 120px; min-width: 60px; font-size: 11.5px; color: #757a87; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.px-protect { display: inline-flex; align-items: center; gap: 6px; height: 30px; padding: 0 11px; border-radius: 99px; border: 1px solid #ff4f8b55; background: #ff4f8b12; color: #ff9cbc; font-weight: 800; font-size: 12px; cursor: pointer; white-space: nowrap; flex: none; transition: background .12s, box-shadow .12s; }\n.px-protect:hover { background: #ff4f8b24; }\n.px-protect.on { background: #ff4f8b; border-color: #ff4f8b; color: #1a0710; box-shadow: 0 4px 16px #ff4f8b55; }\n/* body: tool rail, stage, panels */\n.px-body { display: grid; grid-template-columns: 82px minmax(0, 1fr) 300px; min-height: 0; }\n.px-tools { display: grid; grid-template-columns: repeat(2, 34px); justify-content: center; align-content: start; gap: 3px; padding: 8px 0; background: var(--pb); border-right: 1px solid var(--pl); overflow-y: auto; scrollbar-width: none; }\n.px-tool { width: 34px; height: 34px; display: grid; place-items: center; border-radius: 10px; border: 0; background: none; color: #a9adba; cursor: pointer; transition: background .12s, color .12s, box-shadow .12s, transform .12s; }\n.px-tool:hover { background: #ffffff10; color: #fff; }\n.px-tool:active { transform: scale(.94); }\n.px-tool.on { color: #fff; background: linear-gradient(135deg, var(--pa), color-mix(in srgb, var(--pa) 60%, #ff4fa3)); box-shadow: 0 4px 14px color-mix(in srgb, var(--pa) 45%, transparent); }\n.px-tsep { grid-column: 1 / -1; height: 1px; background: #ffffff14; margin: 4px 6px; }\n.px-railcols { grid-column: 1 / -1; position: relative; width: 56px; height: 50px; margin: 10px auto 4px; border: 0; padding: 0; background: none; cursor: pointer; }\n.px-railcols i { position: absolute; width: 32px; height: 32px; border-radius: 8px; border: 2px solid #ffffffd0; box-shadow: 0 3px 10px #0008; }\n.px-rc1 { left: 0; top: 0; z-index: 1; } .px-rc2 { right: 0; bottom: 0; border-color: #ffffff70 !important; }\n.px-stage { position: relative; overflow: hidden; background: radial-gradient(circle at 50% 40%, #1a1b21, #0c0d10); cursor: crosshair; }\n.px-view { position: absolute; inset: 0; display: block; touch-action: none; }\n#yapstudio-pixel.t-hand .px-stage, #yapstudio-pixel.space .px-stage { cursor: grab; }\n#yapstudio-pixel.panning .px-stage { cursor: grabbing; }\n.px-pill { position: absolute; right: 12px; bottom: 12px; display: flex; align-items: center; gap: 1px; padding: 4px; border-radius: 13px; background: #1d1e25e8; border: 1px solid #ffffff18; box-shadow: 0 10px 30px #0009; backdrop-filter: blur(8px); z-index: 2; }\n.px-pill .px-btn { height: 30px; padding: 0 7px; }\n.px-psep { width: 1px; height: 18px; background: #ffffff1c; margin: 0 3px; }\n.px-zoom { min-width: 56px; height: 30px; border: 0; border-radius: 8px; background: none; text-align: center; font-weight: 800; font-size: 12px; color: #fff; font-variant-numeric: tabular-nums; cursor: pointer; }\n.px-zoom:hover, .px-zoom.open { background: #ffffff14; }\n.px-selbar { position: absolute; left: 50%; top: 10px; transform: translateX(-50%); display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 3px; max-width: calc(100% - 24px); padding: 4px; border-radius: 12px; background: #1d1e25eb; border: 1px solid #ffffff18; box-shadow: 0 10px 30px #0009; backdrop-filter: blur(8px); z-index: 2; animation: px-menu-in .15s ease-out both; }\n.px-selbar .px-mini { padding: 5px 8px; }\n.px-selsize { padding: 0 8px; font-size: 11.5px; font-weight: 800; color: var(--pa); white-space: nowrap; font-variant-numeric: tabular-nums; }\n.px-bsep { width: 1px; height: 16px; background: #ffffff1c; margin: 0 2px; }\n.px-dropnote { position: absolute; inset: 14px; display: none; place-content: center; justify-items: center; gap: 6px; border: 2px dashed color-mix(in srgb, var(--pa) 70%, transparent); border-radius: 18px; background: #0f1014cc; color: var(--pa); z-index: 3; pointer-events: none; }\n.px-dropnote b { color: #fff; font-size: 16px; } .px-dropnote span { color: #9ea3ae; }\n#yapstudio-pixel.px-dropping .px-dropnote { display: grid; }\n.px-side { display: flex; flex-direction: column; gap: 8px; padding: 8px; background: var(--pb); border-left: 1px solid var(--pl); overflow-y: auto; min-height: 0; }\n.px-panel { padding: 10px 12px 12px; border-radius: 13px; background: var(--pc); border: 1px solid #ffffff10; flex: none; }\n.px-panel.folded { padding-bottom: 10px; }\n.px-panel.folded .px-h { margin-bottom: 0; }\n.px-grow { flex: 1 0 auto; display: flex; f