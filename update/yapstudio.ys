4%, transparent); border: 1px solid color-mix(in srgb, var(--ys-accent) 35%, transparent); padding: 1px 7px; border-radius: 999px; letter-spacing: .02em; }\n.ys-tag { font-size: 12px; color: var(--ys-mut); }\n.ys-searchbox { flex: 1; display: flex; align-items: center; gap: 8px; max-width: 360px; margin-left: auto; background: var(--ys-card); border: 1px solid var(--ys-line2); border-radius: 10px; padding: 0 12px; color: var(--ys-faint); transition: border-color .15s, box-shadow .15s; }\n.ys-searchbox:focus-within { border-color: color-mix(in srgb, var(--ys-accent) 60%, transparent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--ys-accent) 16%, transparent); }\n.ys-search { flex: 1; background: none; border: none; outline: none; color: var(--ys-text); padding: 9px 0; font-size: 13.5px; min-width: 0; }\n.ys-search::placeholder { color: var(--ys-faint); }\n.ys-master { display: flex; align-items: center; gap: 9px; padding: 6px 8px 6px 12px; border-radius: 999px; background: var(--ys-card); border: 1px solid var(--ys-line2); font-size: 12.5px; font-weight: 600; color: var(--ys-mut); flex: none; }\n.ys-master.on { color: #fff; border-color: color-mix(in srgb, #3fcf82 40%, transparent); }\n.ys-dot { width: 8px; height: 8px; border-radius: 50%; background: #6d717b; }\n.ys-master.on .ys-dot { background: #3fcf82; box-shadow: 0 0 0 3px #3fcf8233, 0 0 10px #3fcf82; }\n.ys-shell { display: grid; grid-template-columns: 196px minmax(0, 1fr); min-height: calc(100vh - 70px); }\n.ys-side { position: sticky; top: 67px; align-self: start; padding: 16px 10px 20px; border-right: 1px solid var(--ys-line); height: calc(100vh - 70px); overflow-y: auto; display: flex; flex-direction: column; }\n.ys-side-group { font-size: 10.5px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--ys-faint); padding: 14px 10px 6px; }\n.ys-side-group:first-child { padding-top: 2px; }\n.ys-side-item { display: flex; align-items: center; gap: 10px; width: 100%; border: none; background: none; color: var(--ys-mut); padding: 8px 10px; border-radius: 9px; cursor: pointer; font-size: 13.5px; font-weight: 600; text-align: left; position: relative; transition: background .12s, color .12s; }\n.ys-side-item:hover { background: var(--ys-card); color: var(--ys-text); }\n.ys-side-item.on { background: color-mix(in srgb, var(--ys-accent) 13%, var(--ys-card)); color: #fff; }\n.ys-side-item.on::before { content: ""; position: absolute; left: -10px; top: 7px; bottom: 7px; width: 3px; border-radius: 0 3px 3px 0; background: linear-gradient(var(--ys-accent), var(--ys-accent2)); }\n.ys-side-item.on svg { color: var(--ys-accent); }\n.ys-side-foot { margin-top: auto; padding: 16px 10px 0; display: grid; gap: 2px; }\n.ys-main { padding: 22px 28px 70px; min-width: 0; }\n.ys-page-head { display: flex; align-items: center; gap: 14px; margin-bottom: 18px; }\n.ys-page-head h2 { margin: 0; font-size: 20px; color: #fff; letter-spacing: -.01em; }\n.ys-page-icon { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; color: var(--ys-accent); flex: none;\n  background: color-mix(in srgb, var(--ys-accent) 12%, var(--ys-card)); border: 1px solid color-mix(in srgb, var(--ys-accent) 28%, transparent); }\n.ys-content { max-width: 780px; }\n.ys-anim > * { animation: ys-rise .28s cubic-bezier(.2,.8,.2,1) both; }\n.ys-anim > *:nth-child(2) { animation-delay: .03s; } .ys-anim > *:nth-child(3) { animation-delay: .06s; } .ys-anim > *:nth-child(4) { animation-delay: .09s; } .ys-anim > *:nth-child(n+5) { animation-delay: .12s; }\n@keyframes ys-rise { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }\n.ys-off { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; padding: 12px 16px; border-radius: 12px; background: #f2555a14; border: 1px solid #f2555a55; color: #ffb4b6; font-size: 13px; }\n.ys-card { background: var(--ys-card); border: 1px solid var(--ys-line); border-radius: 14px; padding: 18px 20px; m