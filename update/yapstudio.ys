0%; background: var(--ys-bg); font-family: Inter, "Segoe UI", system-ui, sans-serif; }\n#${p} * { box-sizing: border-box; }\n.ys-top { position: sticky; top: 0; z-index: 5; display: flex; align-items: center; gap: 16px; padding: 14px 22px; background: color-mix(in srgb, var(--ys-bg) 88%, transparent);\n  backdrop-filter: blur(12px); border-bottom: 1px solid var(--ys-line); }\n.ys-top::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 1px; background: linear-gradient(90deg, transparent, var(--ys-accent), var(--ys-accent2), transparent); opacity: .6; }\n.ys-brand { display: flex; align-items: center; gap: 11px; min-width: 0; }\n.ys-logo { width: 38px; height: 38px; border-radius: 11px; display: grid; place-items: center; color: #fff; flex: none;\n  background: linear-gradient(135deg, var(--ys-accent), var(--ys-accent2)); box-shadow: 0 6px 20px color-mix(in srgb, var(--ys-accent) 40%, transparent), inset 0 1px 0 #ffffff40; }\n.ys-name { display: flex; align-items: center; gap: 8px; font-size: 16px; font-weight: 700; color: #fff; letter-spacing: -.01em; white-space: nowrap; }\n.ys-ver { font-size: 10.5px; font-weight: 700; color: var(--ys-accent); background: color-mix(in srgb, var(--ys-accent) 14%, transparent); border: 1px solid color-mix(in srgb, var(--ys-accent) 35%, transparent); padding: 1px 7px; border-radius: 999px; letter-spacing: .02em; }\n.ys-tag { font-size: 12px; color: var(--ys-mut); }\n.ys-searchbox { flex: 1; display: flex; align-items: center; gap: 8px; max-width: 360px; margin-left: auto; background: var(--ys-card); border: 1px solid var(--ys-line2); border-radius: 10px; padding: 0 12px; color: var(--ys-faint); transition: border-color .15s, box-shadow .15s; }\n.ys-searchbox:focus-within { border-color: color-mix(in srgb, var(--ys-accent) 60%, transparent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--ys-accent) 16%, transparent); }\n.ys-search { flex: 1; background: none; border: none; outline: none; color: var(--ys-text); padding: 9px 0; font-size: 13.5px; min-width: 0; }\n.ys-search::placeholder { color: var(--ys-faint); }\n.ys-master { display: flex; align-items: center; gap: 9px; padding: 6px 8px 6px 12px; border-radius: 999px; background: var(--ys-card); border: 1px solid var(--ys-line2); font-size: 12.5px; font-weight: 600; color: var(--ys-mut); flex: none; }\n.ys-master.on { color: #fff; border-color: color-mix(in srgb, #3fcf82 40%, transparent); }\n.ys-dot { width: 8px; height: 8px; border-radius: 50%; background: #6d717b; }\n.ys-master.on .ys-dot { background: #3fcf82; box-shadow: 0 0 0 3px #3fcf8233, 0 0 10px #3fcf82; }\n.ys-shell { display: grid; grid-template-columns: 196px minmax(0, 1fr); min-height: calc(100vh - 70px); }\n.ys-side { position: sticky; top: 67px; align-self: start; padding: 16px 10px 20px; border-right: 1px solid var(--ys-line); height: calc(100vh - 70px); overflow-y: auto; display: flex; flex-direction: column; }\n.ys-side-group { font-size: 10.5px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--ys-faint); padding: 14px 10px 6px; }\n.ys-side-group:first-child { padding-top: 2px; }\n.ys-side-item { display: flex; align-items: center; gap: 10px; width: 100%; border: none; background: none; color: var(--ys-mut); padding: 8px 10px; border-radius: 9px; cursor: pointer; font-size: 13.5px; font-weight: 600; text-align: left; position: relative; transition: background .12s, color .12s; }\n.ys-side-item:hover { background: var(--ys-card); color: var(--ys-text); }\n.ys-side-item.on { background: color-mix(in srgb, var(--ys-accent) 13%, var(--ys-card)); color: #fff; }\n.ys-side-item.on::before { content: ""; position: absolute; left: -10px; top: 7px; bottom: 7px; width: 3px; border-radius: 0 3px 3px 0; background: linear-gradient(var(--ys-accent), var(--ys-accent2)); }\n.ys-side-item.on svg { color: var(--ys-accent); }\n.ys-side-foot { margin-top: auto; padding: 16px 10px 0; display: grid; gap: 2px; }\n.ys-main { padding: 22px 28px 70px; min-width: 0; }\n.ys-page-head { display: flex; align-items: center; gap: 14px; margin-bottom: 18px; }\n.ys-page-head h2 { margin: 0; font-size: 20px; color: #fff; letter-spacing: -.01em; }\n.ys-page-icon { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; color: var(--ys-accent); flex: none;\n  background: color-mix(in srgb, var(--ys-accent) 12%, var(--ys-card)); border: 1px solid color-mix(in srgb, var(--ys-accent) 28%, transparent); }\n.ys-content { max-width: 780px; }\n.ys-anim > * { animation: ys-rise .28s cubic-bezier(.2,.8,.2,1) both; }\n.ys-anim > *:nth-child(2) { animation-delay: .03s; } .ys-anim > *:nth-child(3) { animation-delay: .06s; } .ys-anim > *:nth-child(4) { animation-delay: .09s; } .ys-anim > *:nth-child(n+5) { animation-delay: .12s; }\n@keyframes ys-rise { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }\n.ys-off { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; padding: 12px 16px; border-radius: 12px; background: #f2555a14; border: 1px solid #f2555a55; color: #ffb4b6; font-size: 13px; }\n.ys-card { background: var(--ys-card); border: 1px solid var(--ys-line); border-radius: 14px; padding: 18px 20px; margin-bottom: 14px; box-shadow: 0 1px 0 #ffffff06 inset, 0 8px 24px #0000001f; }\n.ys-card-head { margin-bottom: 8px; }\n.ys-card h3 { margin: 0; font-size: 14.5px; color: var(--ys-text); font-weight: 700; }\n.ys-desc { font-size: 12.5px; color: var(--ys-mut); margin-top: 3px; }\n.ys-crumb { display: inline-block; font-size: 10.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--ys-accent); margin-bottom: 6px; }\n.ys-row { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 11px 0; }\n.ys-row + .ys-row { border-top: 1px solid var(--ys-line); }\n.ys-row.hidden { display: none; }\n.ys-label { font-size: 13.5px; color: var(--ys-text); font-weight: 600; }\n.ys-hint { font-size: 12px; color: var(--ys-mut); }\n.ys-empty { padding: 40px 10px; text-align: center; color: var(--ys-mut); }\n.ys-fine { font-size: 11.5px; color: var(--ys-faint); text-align: center; margin: 18px 0 4px; }\n.ys-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px; width: 100%; }\n.ys-color { display: flex; align-items: center; gap: 10px; background: var(--ys-card2); border: 1px solid var(--ys-line); border-radius: 10px; padding: 7px 10px; cursor: pointer; transition: border-color .12s; }\n.ys-color:hover { border-color: var(--ys-line2); }\n.ys-color input { width: 26px; height: 26px; border: none; padding: 0; background: none; cursor: pointer; border-radius: 7px; }\n.ys-color span { font-size: 13px; color: var(--ys-text); font-weight: 500; }\n.ys-presets { display: grid; grid-template-columns: repeat(auto-fill, minmax(128px, 1fr)); gap: 10px; }\n.ys-preset { border: 1px solid var(--ys-line); border-radius: 12px; overflow: hidden; cursor: pointer; background: var(--ys-card2); text-align: left; padding: 0; color: var(--ys-text); transition: transform .14s, border-color .14s, box-shadow .14s; }\n.ys-preset:hover { transform: translateY(-2px); border-color: var(--ys-line2); box-shadow: 0 8px 18px #0004; }\n.ys-preset.on { border-color: var(--ys-accent); box-shadow: 0 0 0 2px color-mix(in srgb, var(--ys-accent) 40%, transparent); }\n.ys-preset .sw { display: flex; height: 38px; }\n.ys-preset .sw i { flex: 1; }\n.ys-preset .nm { font-size: 12px; padding: 8px 10px; font-weight: 600; }\n.ys-switch { position: relative; width: 40px; height: 22px; flex-shrink: 0; display: inline-block; }\n.ys-switch input { opacity: 0; width: 0; height: 0; position: absolute; }\n.ys-switch i { position: absolute; inset: 0; background: #3a3c44; border-radius: 22px; transition: background .18s; cursor: pointer; box-shadow: inset 0 1px 2px #0006; }\n.ys-switch i::before { content: ""; position: absolute; width: 16px; height: 16px; left: 3px; top: 3px; background: #fff; border-radius: 50%; transition: transform .2s cubic-bezier(.34,1.56,.64,1); box-shadow: 0 1px 3px #0006; }\n.ys-switch input:checked + i { background: linear-gradient(135deg, var(--ys-accent), var(--ys-accent2)); }\n.ys-switch input:checked + i::before { transform: translateX(18px); }\n.ys-range { display: flex; align-items: center; gap: 12px; min-width: 250px; }\n.ys-range input { flex: 1; accent-color: var(--ys-accent); }\n.ys-range b { font-size: 12px; color: var(--ys-text); min-width: 54px; text-align: center; font-weight: 700; background: var(--ys-card2); border: 1px solid var(--ys-line); padding: 3px 6px; border-radius: 7px; font-variant-numeric: tabular-nums; }\n.ys-select, .ys-text { background: var(--ys-bg); border: 1px solid var(--ys-line2); border-radius: 9px; color: var(--ys-text); padding: 8px 11px; font-size: 13px; outline: none; transition: border-color .15s, box-shadow .15s; }\n.ys-select:focus, .ys-text:focus { border-color: color-mix(in srgb, var(--ys-accent) 60%, transparent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--ys-accent) 16%, transparent); }\n.ys-text { width: 100%; }\n.ys-area { width: 100%; min-height: 150px; background: var(--ys-bg); border: 1px solid var(--ys-line2); border-radius: 10px; color: #e6e6ea; padding: 11px 13px; font: 12.5px/1.6 Consolas, "Cascadia Mono", monospace; resize: vertical; outline: none; }\n.ys-area:focus { border-color: color-mix(in srgb, var(--ys-accent) 60%, transparent); }\n.ys-seg { display: inline-flex; background: var(--ys-bg); border: 1px solid var(--ys-line2); border-radius: 10px; padding: 3px; gap: 2px; flex-wrap: wrap; }\n.ys-seg button { background: none; border: none; color: var(--ys-mut); padding: 5px 11px; border-radius: 7px; cursor: pointer; font-size: 12.5px; font-weight: 600; transition: background .12s, color .12s; }\n.ys-seg button:hover { color: var(--ys-text); }\n.ys-seg button.on { background: linear-gradient(135deg, var(--ys-accent), var(--ys-accent2)); color: #fff; box-shadow: 0 2px 8px color-mix(in srgb, var(--ys-accent) 35%, transparent); }\n.ys-btn { background: linear-gradient(135deg, var(--ys-accent), var(--ys-accent2)); color: #fff; border: none; border-radius: 10px; padding: 9px 15px; font-weight: 700; font-size: 13px; cursor: pointer; transition: filter .12s, transform .1s, box-shadow .12s; box-shadow: 0 4px 14px color-mix(in srgb, var(--ys-accent) 30%, transparent), inset 0 1px 0 #ffffff33; }\n.ys-btn:hover { filter: brightness(1.08); }\n.ys-btn:active { transform: scale(.97); }\n.ys-btn.ghost { background: var(--ys-card2); color: var(--ys-text); border: 1px solid var(--ys-line2); box-shadow: none; }\n.ys-btn.danger { background: #da373c; box-shadow: none; }\n.ys-btns { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }\n.ys-note { font-size: 12px; color: var(--ys-mut); margin-top: 8px; min-height: 16px; }\n.ys-chip { display: inline-flex; align-items: center; gap: 6px; background: var(--ys-card2); border: 1px solid var(--ys-line); border-radius: 999px; padding: 5px 6px 5px 12px; font-size: 13px; margin: 0 6px 6px 0; }\n.ys-chip button { background: #3a3c44; border: none; color: var(--ys-text); border-radius: 999px; padding: 3px 9px; cursor: pointer; font-size: 12px; }\n.ys-chip button.load { background: var(--ys-accent); color: #fff; }\n.ys-kbd { display: inline-block; background: var(--ys-card2); border: 1px solid var(--ys-line2); border-bottom-width: 2px; border-radius: 6px; padding: 2px 8px; font: 12px Consolas, monospace; color: var(--ys-text); }\n.ys-two { display: grid; grid-template-columns: 1.25fr 1fr; gap: 14px; margin-bottom: 14px; }\n.ys-two > .ys-card { margin-bottom: 0; }\n@media (max-width: 980px) { .ys-two { grid-template-columns: 1fr; } }\n@media (max-width: 760px) { .ys-shell { grid-template-columns: 1fr; } .ys-side { position: static; height: auto; flex-direction: row; flex-wrap: wrap; border-right: none; border-bottom: 1px solid var(--ys-line); } .ys-side-group, .ys-side-foot { display: none; } .ys-side-item { width: auto; } }\n.ys-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 4px; }\n.ys-stat { background: var(--ys-card2); border: 1px solid var(--ys-line); border-radius: 11px; padding: 11px 12px; }\n.ys-stat b { display: block; font-size: 22px; color: #fff; line-height: 1.1; font-variant-numeric: tabular-nums; }\n.ys-stat span { font-size: 10.5px; color: var(--ys-mut); text-transform: uppercase; letter-spacing: .06em; font-weight: 600; }\n.ys-preview { display: flex; height: 176px; border-radius: 12px; overflow: hidden; border: 1px solid var(--ys-line2); box-shadow: 0 10px 30px #0005; }\n.ys-preview .r { width: 36px; display: flex; flex-direction: column; align-items: center; gap: 7px; padding-top: 9px; }\n.ys-preview .r i { width: 22px; height: 22px; border-radius: 8px; display: block; }\n.ys-preview .s { width: 96px; padding: 11px 9px; display: flex; flex-direction: column; gap: 7px; }\n.ys-preview .s i { height: 8px; border-radius: 4px; display: block; }\n.ys-preview .m { flex: 1; padding: 13px; display: flex; flex-direction: column; gap: 10px; position: relative; }\n.ys-preview .msgl { display: flex; gap: 8px; align-items: flex-start; }\n.ys-preview .av { width: 20px; height: 20px; border-radius: 50%; flex: none; }\n.ys-preview .ln { height: 7px; border-radius: 4px; display: block; margin-bottom: 4px; }\n.ys-preview .in { position: absolute; left: 13px; right: 13px; bottom: 11px; height: 22px; border-radius: 9px; }\n.ys-credit-hero { display: flex; align-items: center; gap: 16px; padding: 22px; margin-bottom: 14px; border-radius: 16px; position: relative; overflow: hidden;\n  background: linear-gradient(120deg, color-mix(in srgb, var(--ys-accent) 30%, var(--ys-card)), color-mix(in srgb, var(--ys-accent2) 18%, var(--ys-card)) 65%, var(--ys-card)); border: 1px solid color-mix(in srgb, var(--ys-accent) 30%, transparent); }\n.ys-credit-logo { width: 58px; height: 58px; border-radius: 16px; display: grid; place-items: 