letter-spacing: .14em; color: var(--ck-a); }\n.ys-ck-pixel .ys-ck-bar { display: flex; gap: 2px; margin-top: calc(6px * var(--ck)); height: var(--ck-px); background: repeating-linear-gradient(90deg, #ffffff14 0 calc(var(--ck-px) * 2), transparent 0 calc(var(--ck-px) * 2 + 2px)); }\n.ys-ck-pixel .ys-ck-bar i { display: block; height: 100%; background: repeating-linear-gradient(90deg, var(--ck-a) 0 calc(var(--ck-px) * 2), transparent 0 calc(var(--ck-px) * 2 + 2px)); }\n/* Pill (the classic look) */\n.ys-ck-pill { padding: calc(4px * var(--ck)) calc(11px * var(--ck)); border-radius: 999px; background: color-mix(in srgb, var(--bg-float, #1e1f22) 88%, transparent); border: 1px solid #ffffff1a; box-shadow: 0 4px 14px #0006; backdrop-filter: blur(8px); }\n.ys-ck-pill .ys-ck-time { font-size: calc(12.5px * var(--ck)); font-weight: 700; }\n.ys-ck-pill .ys-ck-sec { color: inherit; opacity: .7; font-size: calc(12.5px * var(--ck)); font-weight: 700; margin-left: -4px; }\n.ys-ck-pill .ys-ck-ampm { font-size: calc(9px * var(--ck)); padding: 1px 5px; }\n/* ---- Studio redesign ---- */\n#${p} .ys-card { position: relative; transition: border-color .2s, box-shadow .2s; }\n#${p}.ys-glow .ys-card::before { content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; opacity: 0; transition: opacity .3s;\n  background: radial-gradient(560px circle at var(--mx, 50%) var(--my, 50%), color-mix(in srgb, var(--ys-accent) 8%, transparent), transparent 45%); }\n#${p}.ys-glow .ys-card::after { content: ""; position: absolute; inset: -1px; border-radius: inherit; padding: 1px; pointer-events: none; opacity: 0; transition: opacity .3s;\n  background: radial-gradient(320px circle at var(--mx, 50%) var(--my, 50%), color-mix(in srgb, var(--ys-accent) 90%, transparent), transparent 55%);\n  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; }\n#${p}.ys-glow .ys-card:hover::before, #${p}.ys-glow .ys-card:hover::after { opacity: 1; }\n#${p} .ys-card:hover { box-shadow: 0 1px 0 #ffffff08 inset, 0 14px 36px #00000040, 0 0 34px color-mix(in srgb, var(--ys-accent) 7%, transparent); }\n.ys-side-ind { position: absolute; left: 10px; right: 10px; top: 0; height: 36px; border-radius: 10px; pointer-events: none; opacity: 0; z-index: 0;\n  background: linear-gradient(90deg, color-mix(in srgb, var(--ys-accent) 22%, var(--ys-card)), color-mix(in srgb, var(--ys-accent2) 10%, var(--ys-card)));\n  box-shadow: 0 0 0 1px color-mix(in srgb, var(--ys-accent) 30%, transparent), 0 6px 20px color-mix(in srgb, var(--ys-accent) 20%, transparent);\n  transition: transform .34s cubic-bezier(.34,1.32,.64,1), height .2s, opacity .2s; }\n.ys-side-ind.on { opacity: 1; }\n.ys-side-ind::before { content: ""; position: absolute; left: -10px; top: 7px; bottom: 7px; width: 3px; border-radius: 0 3px 3px 0; background: linear-gradient(var(--ys-accent), var(--ys-accent2)); box-shadow: 0 0 10px var(--ys-accent); }\n.ys-side { position: sticky; }\n.ys-side-item { position: relative; z-index: 1; transition: color .15s, background .15s; }\n.ys-side-item.on, .ys-side-item.on:hover { background: transparent; }\n.ys-side-item.on::before { display: none; }\n.ys-side-item:hover:not(.on) { background: color-mix(in srgb, var(--ys-card) 80%, transparent); box-shadow: inset 0 0 0 1px var(--ys-line); }\n@media (max-width: 760px) { .ys-side-ind { display: none; } .ys-side-item.on { background: color-mix(in srgb, var(--ys-accent) 13%, var(--ys-card)); } }\n.ys-switch input:checked + i { box-shadow: 0 0 14px color-mix(in srgb, var(--ys-accent) 55%, transparent), inset 0 1px 2px #0003; }\n.ys-switch:hover i { filter: brightness(1.1); }\n.ys-btn { position: relative; overflow: hidden; display: inline-flex; align-items: center; gap: 6px; }\n.ys-btn svg { flex: none; }\n.ys-btn::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(105deg, transparent 35%, #ffffff40 50%, transparent 65%); transform: translateX(-130%); transition: transform .55s ease; }\n.ys-btn:hover::after { transform: translateX(130%); }\n.ys-btn:not(.ghost):hover { box-shadow: 0 6px 20px color-mix(in srgb, var(--ys-accent) 40%, transparent); }\n.ys-btn.ghost:hover { border-color: color-mix(in srgb, var(--ys-accent) 45%, var(--ys-line2)); }\n.ys-logo { animation: ys-logo-glow 4s ease-in-out infinite; }\n@keyframes ys-logo-glow { 0%, 100% { box-shadow: 0 6px 18px color-mix(in srgb, var(--ys-accent) 35%, transparent); } 50% { box-shadow: 0 6px 26px color-mix(in srgb, var(--ys-accent) 65%, transparent); } }\n.ys-page-icon { box-shadow: 0 0 22px color-mix(in srgb, var(--ys-accent) 22%, transparent); }\n.ys-text:focus, .ys-select:focus, .ys-area:focus { outline: none; border-color: var(--ys-accent) !important; box-shadow: 0 0 0 3px color-mix(in srgb, var(--ys-accent) 22%, transparent); }\n.ys-preset:hover { box-shadow: 0 0 0 1px color-mix(in srgb, var(--ys-accent) 45%, transparent), 0 10px 26px color-mix(in srgb, var(--ys-accent) 18%, transparent); }\n/* ---- Pixel Studio page ---- */\n.ys-px-hero { display: grid; grid-template-columns: auto 1fr; gap: 22px; align-items: center; padding: 20px 22px; border-radius: 18px; margin-bottom: 12px;\n  background: radial-gradient(120% 140% at 0% 0%, color-mix(in srgb, var(--ys-accent) 20%, transparent), transparent 55%), var(--ys-card); border: 1px solid color-mix(in srgb, var(--ys-accent) 32%, var(--ys-line)); }\n.ys-px-art { width: 108px; height: 108px; display: grid; grid-template-columns: repeat(6, 1fr); gap: 2px; padding: 6px; border-radius: 14px; background: #0005; border: 1px solid #ffffff1f; }\n.ys-px-art i { border-radius: 2px; background: #ffffff10; animation: ys-px-blink 3.2s ease-in-out infinite; }\n.ys-px-art i:nth-child(3n) { background: var(--ys-accent); animation-delay: .4s; } .ys-px-art i:nth-child(5n) { background: var(--ys-accent2); animation-delay: .9s; } .ys-px-art i:nth-child(7n) { background: #ffd23f;