; image-rendering: pixelated; }\n.ys-badge-opt.on { border-color: var(--ys-accent); background: color-mix(in srgb, var(--ys-accent) 12%, var(--ys-card2)); box-shadow: 0 0 0 1px var(--ys-accent) inset; }\n.ys-tagbox { font: 13px Consolas, monospace; background: var(--ys-bg); border: 1px dashed var(--ys-line2); border-radius: 9px; padding: 9px 11px; color: var(--ys-text); user-select: all; flex: 1; }\n#${d} { display: flex; align-items: center; gap: 8px; color: #ff8a5c; font-weight: 600; }\n#${d} svg { width: 18px; height: 18px; }\n#${f} { position: fixed; right: 20px; bottom: 90px; z-index: 2147483000; width: 296px; background: #1a1b20f7; color: #dbdee1; font-size: 13px; font-family: Inter, "Segoe UI", system-ui, sans-serif;\n  border: 1px solid #ffffff1a; border-radius: 16px; box-shadow: 0 20px 50px #000b; backdrop-filter: blur(14px); --ys-accent: #e27ed3; --ys-accent2: #ff4fa3; --ys-card2: #2a2b32; --ys-line: #ffffff0f; --ys-line2: #ffffff1a; --ys-text: #f2f3f5; --ys-mut: #9ea3ae; --ys-bg: #17181c; overflow: hidden; }\n#${f} header { display: flex; align-items: center; justify-content: space-between; padding: 12px 14px; cursor: move; font-weight: 700; color: #fff;\n  background: linear-gradient(120deg, color-mix(in srgb, var(--ys-accent) 38%, #1a1b20), #1a1b20); border-bottom: 1px solid #ffffff12; }\n#${f} header button { background: none; border: none; color: #ffffffa0; font-size: 18px; cursor: pointer; line-height: 1; }\n#${f} .q { padding: 8px 14px 13px; display: grid; gap: 2px; }\n#${f} .ys-range { min-width: 0; }\n#${f} .ys-select { width: 100%; margin: 6px 0; }\n#${f} .ys-row { padding: 8px 0; }\n#${f} .ys-row + .ys-row { border-top: 1px solid #ffffff0d; }\n#${h} { position: fixed; top: 8px; right: 12px; z-index: 2147482000; cursor: grab; user-select: none; color: #fff; font-family: Inter, "Segoe UI", system-ui, sans-serif;\n  --ck: 1; --ck-px: 4px; animation: ys-ck-in .35s cubic-bezier(.34,1.4,.64,1) both; }\n@keyframes ys-ck-in { from { opacity: 0; transfor