 transparent); color: var(--ys-accent, #ff9a6c); font-size: 12px; font-weight: 700; vertical-align: 1px; cursor: help; }\n.msg.ys-fa-hidden .msg-body > :not(.msg-head) { display: none !important; }\n.msg.ys-fa-hidden .msg-body::after { content: "Hidden message (click to show)"; display: block; padding: 2px 0; font-size: 12.5px; font-style: italic; opacity: .6; cursor: pointer; }\n.msg.ys-fa-hidden .msg-gutter { opacity: .35; }\n.msg.ys-fa-found { box-shadow: inset 3px 0 0 color-mix(in srgb, var(--ys-accent, #ff7a45) 55%, transparent); }\n.msg.ys-fa-cur { box-shadow: inset 3px 0 0 var(--ys-accent, #ff7a45) !important; background: color-mix(in srgb, var(--ys-accent, #ff7a45) 14%, transparent) !important; }\n.msg.ys-fa-flash { animation: ys-fa-flash 1.6s ease; }\n@keyframes ys-fa-flash { 0%, 60% { background: color-mix(in srgb, var(--ys-accent, #ff7a45) 26%, transparent); } 100% { background: transparent; } }\n.ys-fa-pop { position: fixed; z-index: 2147483500; min-width: 220px; padding: 5px; border-radius: 12px; background: #1f2026f2; border: 1px solid #ffffff1f; box-shadow: 0 16px 40px #000a; font: 13px "Segoe UI", Inter, system-ui, sans-serif; }\n.ys-fa-item { display: flex; align-items: center; gap: 9px; width: 100%; padding: 8px 10px; border: 0; border-radius: 8px; background: none; color: #e6e7ec; font: inherit; text-align: left; cursor: pointer; }\n.ys-fa-item:hover, .ys-fa-item:focus-visible { background: color-mix(in srgb, var(--ys-accent, #ff7a45) 24%, transparent); color: #fff; outline: none; }\n.ys-fa-item svg { flex: none; opacity: .85; }\n.ys-fa-sep { height: 1px; margin: 4px 6px; background: #ffffff14; }\n.ys-fa-dlgwrap { position: fixed; inset: 0; z-index: 2147483450; display: grid; place-items: center; background: #05060899; font: 13px "Segoe UI", Inter, system-ui, sans-serif; color: #e8e9ee; }\n.ys-fa-dlgwrap.ys-fa-top { align-items: start; padding-top: 12vh; }\n.ys-fa-dlg { width: 520px; max-width: calc(100vw - 24px); max-height: calc(100vh - 40px); o