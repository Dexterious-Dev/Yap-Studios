ansparent); }\n.ys-dot { width: 8px; height: 8px; border-radius: 50%; background: #6d717b; }\n.ys-master.on .ys-dot { background: #3fcf82; box-shadow: 0 0 0 3px #3fcf8233, 0 0 10px #3fcf82; }\n.ys-shell { display: grid; grid-template-columns: 196px minmax(0, 1fr); min-height: calc(100vh - 70px); }\n.ys-side { position: sticky; top: 67px; align-self: start; padding: 16px 10px 20px; border-right: 1px solid var(--ys-line); height: calc(100vh - 70px); overflow-y: auto; display: flex; flex-direction: column; }\n.ys-side-group { font-size: 10.5px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--ys-faint); padding: 14px 10px 6px; }\n.ys-side-group:first-child { padding-top: 2px; }\n.ys-side-item { display: flex; align-items: center; gap: 10px; width: 100%; border: none; background: none; color: var(--ys-mut); padding: 8px 10px; border-radius: 9px; cursor: pointer; font-size: 13.5px; font-weight: 600; text-align: left; position: relative; transition: background .12s, color .12s; }\n.ys-side-item:hover { background: var(--ys-card); color: var(--ys-text); }\n.ys-side-item.on { background: color-mix(in srgb, var(--ys-accent) 13%, var(--ys-card)); color: #fff; }\n.ys-side-item.on::before { content: ""; position: absolute; left: -10px; top: 7px; bottom: 7px; width: 3px; border-radius: 0 3px 3px 0; background: linear-gradient(var(--ys-accent), var(--ys-accent2)); }\n.ys-side-item.on svg { color: var(--ys-accent); }\n.ys-side-foot { margin-top: auto; padding: 16px 10px 0; display: grid; gap: 2px; }\n.ys-main { padding: 22px 28px 70px; min-width: 0; }\n.ys-page-head { display: flex; align-items: center; gap: 14px; margin-bottom: 18px; }\n.ys-page-head h2 { margin: 0; font-size: 20px; color: #fff; letter-spacing: -.01em; }\n.ys-page-icon { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; color: var(--ys-accent); flex: none;\n  background: color-mix(in srgb, var(--ys-accent) 12%, var(--ys-card)); border: 1px solid color-mix(in srgb, var(--ys-accent) 28%, transparent); }\n.ys-content { max-width: 780px; }\n.ys-anim > * { animation: ys-rise .28s cubic-bezier(.2,.8,.2,1) both; }\n.ys-anim > *:nth-child(2) { animation-delay: .03s; } .ys-anim > *:nth-child(3) { animation-delay: .06s; } .ys-anim > *:nth-child(4) { animation-delay: .09s; } .ys-anim > *:nth-child(n+5) { animation-delay: .12s; }\n@keyframes ys-rise { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }\n.ys-off { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; padding: 12px 16px; border-radius: 12px; background: #f2555a14; border: 1px solid #f2555a55; color: #ffb4b6; font-size: 13px; }\n.ys-card { background: var(--ys-card); border: 1px solid var(--ys-line); border-radius: 14px; padding: 18px 20px; margin-bottom: 14px; box-shadow: 0 1px 0 #ffffff06 inset, 0 8px 24px #0000001f; }\n.ys-card-head { margin-bottom: 8px; }\n.ys-card h3 { margin: 0; font-size: 14.5px; color: var(--ys-text); font-weight: 700; }\n.ys-desc { font-size: 12.5px; color: var(--ys-mut); margin-top: 3px; }\n.ys-crumb { display: inline-block; font-size: 10.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--ys-accent); margin-bottom: 6px; }\n.ys-row { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 11px 0; }\n.ys-row + .ys-row { border-top: 1px solid var(--ys-line); }\n.ys-row.hidden { display: none; }\n.ys-label { font-size: 13.5px; color: var(--ys-text); font-weight: 600; }\n.ys-hint { font-size: 12px; color: var(--ys-mut); }\n.ys-empty { padding: 40px 10px; text-align: center; color: var(--ys-mut); }\n.ys-fine { font-size: 11.5px; color: var(--ys-faint); text-align: center; margin: 18px 0 4px; }\n.ys-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px; width: 100%; }\n.ys-color { display: flex; align-items: center; gap: 10px; background: var(--ys-card2); border: 1px solid var(--ys-line); border-radius: 10px; padding: 7px 10px; cursor: pointer; transition: border-color .12s; }\n.ys-color:hover { border-color: var(--ys-line2); }\n.ys-color input { width: 26px; height: 26px; border: none; padding: 0; background: none; cursor: pointer; border-radius: 7px; }\n.ys-color span { font-size: 13px; color: var(--ys-text); font-weight: 500; }\n.ys-presets { display: grid; grid-template-columns: repeat(auto-fill, minmax(128px, 1fr)); gap: 10px; }\n.ys-preset { border: 1px solid var(--ys-line); border-radius: 12px; overflow: hidden; cursor: pointer; background: var(--ys-card2); text-align: left; padding: 0; color: var(--ys-text); transition: transform .14s, border-color .14s, box-shadow .14s; }\n.ys-preset:hover { transform: translateY(-2px); border-color: var(--ys-line2); box-shadow: 0 8px 18px #0004; }\n.ys-preset.on { border-color: var(--ys-accent); box-shadow: 0 0 0 2px color-mix(in srgb, var(--ys-accent) 40%, transparent); }\n.ys-preset .sw { display: flex; height: 38px; }\n.ys-preset .sw i { flex: 1; }\n.ys-preset .nm { font-size: 12px; padding: 8px 10px; font-weight: 600; }\n.ys-switch { position: relative; width: 40px; height: 22px; flex-shrink: 0; display: inline-block; }\n.ys-switch input { opacity: 0; width: 0; height: 0; position: absolute; }\n.ys-switch i { position: absolute; inset: 0; background: #3a3c44; border-radius: 22px; transition: background .18s; cursor: pointer; box-shadow: inset 0 1px 2px #0006; }\n.ys-switch i::before { content: ""; position: absolute; width: 16px; height: 16px; left: 3px; top: 3px; background: #fff; border-radius: 50%; transition: transform .2s cubic-bezier(.34,1.56,.64,1); box-shadow: 0 1px 3px #0006; }\n.ys-switch input:checked + i { background: linear-gradient(135deg, var(--ys-accent), var(--ys-accent2)); }\n.ys-switch input:checked + i::before { transform: translateX(18px); }\n.ys-range { display: flex; align-items: center; gap: 12px; min-width: 250px; }\n.ys-range input { flex: 1; accent-color: var(--ys-accent); }\n.ys-range b { font-size: 12px; color: var(--ys-text); min-width: 54px; text-align: center; font-weight: 700; background: var(--ys-card2); border: 1px solid var(--ys-line); padding: 3px 6px; border-radius: 7px; font-variant-numeric: tabular-nums; }\n.ys-select, .ys-text { background: var(--ys-bg); border: 1px solid var(--ys-line2); border-radius: 9px; color: var(--ys-text); padding: 8px 11px; font-size: 13px; outline: none; transition: border-color .15s, box-shadow .15s; }\n.ys-select:focus, .ys-text:focus { border-color: color-mix(in srgb, var(--ys-accent) 60%, transparent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--ys-accent) 16%, transparent); }\n.ys-text { width: 100%; }\n.ys-area { width: 100%; min-height: 150px; background: var(--ys-bg); border: 1px solid var(--ys-line2); border-radius: 10px; color: #e6e6ea; padding: 11px 13px; font: 12.5px/1.6 Consolas, "Cascadia Mono", monospace; resize: vertical; outline: none; }\n.ys-area:focus { border-color: color-mix(in srgb, var(--ys-accent) 60%, transparent); }\n.ys-seg { display: inline-flex; background: var(--ys-bg); border: 1px solid var(--ys-line2); border-radius: 10px; padding: 3px; gap: 2px; flex-wrap: wrap; }\n.ys-seg button { background: none; border: none; color: var(--ys-mut); padding: 5px 11px; border-radius: 7px; cursor: pointer; font-size: 12.5px; font-weight: 600; transition: background .12s, color .12s; }\n.ys-seg button:hover { color: var(--ys-text); }\n.ys-seg button.on { background: linear-gradient(135deg, var(--ys-accent), var(--ys-accent2)); color: #fff; box-shadow: 0 2px 8px color-mix(in srgb, var(--ys-accent) 35%, transparent); }\n.ys-btn { background: linear-gradient(135deg, var(--ys-accent), var(--ys-accent2)); color: #fff; border: none; border-radius: 10px; padding: 9px 15px; font-weight: 700; font-size: 13px; cursor: pointer; transition: filter .12s, transform .1s, box-shadow .12s; box-shadow: 0 4px 14px color-mix(in srgb, var(--ys-accent) 30%, transparent), inset 0 1px 0 #ffffff33; }\n.ys-btn:hover { filter: brightness(1.08); }\n.ys-btn:active { transform: scale(.97); }\n.ys-btn.ghost { background: var(--ys-card2); color: var(--ys-text); border: 1px solid var(--ys-line2); box-shadow: none; }\n.ys-btn.danger { background: #da373c; box-shadow: none; }\n.ys-btns { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }\n.ys-note { font-size: 12px; color: var(--ys-mut); margin-top: 8px; min-height: 16px; }\n.ys-chip { display: inline-flex; align-items: center; gap: 6px; background: var(--ys-card2); border: 1px solid var(--ys-line); border-radius: 999px; padding: 5px 6px 5px 12px; font-size: 13px; margin: 0 6px 6px 0; }\n.ys-chip button { background: #3a3c44; border: none; color: var(--ys-text); border-radius: 999px; padding: 3px 9px; cursor: pointer; font-size: 12px; }\n.ys-chip button.load { background: var(--ys-accent); color: #fff; }\n.ys-kbd { display: inline-block; background: var(--ys-card2); border: 1px solid var(--ys-line2); border-bottom-width: 2px; border-radius: 6px; padding: 2px 8px; font: 12px Consolas, monospace; color: var(--ys-text); }\n.ys-two { display: grid; grid-template-columns: 1.25fr 1fr; gap: 14px; margin-bottom: 14px; }\n.ys-two > .ys-card { margin-bottom: 0; }\n@media (max-width: 980px) { .ys-two { grid-template-columns: 1fr; } }\n@media (max-width: 760px) { .ys-shell { grid-template-columns: 1fr; } .ys-side { position: static; height: auto; flex-direction: row; flex-wrap: wrap; border-right: none; border-bottom: 1px solid var(--ys-line); } .ys-side-group, .ys-side-foot { display: none; } .ys-side-item { width: auto; } }\n.ys-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 4px; }\n.ys-stat { background: var(--ys-card2); border: 1px solid var(--ys-line); border-radius: 11px; padding: 11px 12px; }\n.ys-stat b { display: block; font-size: 22px; color: #fff; line-height: 1.1; font-variant-numeric: tabular-nums; }\n.ys-stat span { font-size: 10.5px; color: var(--ys-mut); text-transform: uppercase; letter-spacing: .06em; font-weight: 600; }\n.ys-preview { display: flex; height: 176px; border-radius: 12px; overflow: hidden; border: 1px solid var(--ys-line2); box-shadow: 0 10px 30px #0005; }\n.ys-preview .r { width: 36px; display: flex; flex-direction: column; align-items: center; gap: 7px; padding-top: 9px; }\n.ys-preview .r i { width: 22px; height: 22px; border-radius: 8px; display: block; }\n.ys-preview .s { width: 96px; padding: 11px 9px; display: flex; flex-direction: column; gap: 7px; }\n.ys-preview .s i { height: 8px; border-radius: 4px; display: block; }\n.ys-preview .m { flex: 1; padding: 13px; display: flex; flex-direction: column; gap: 10px; position: relative; }\n.ys-preview .msgl { display: flex; gap: 8px; align-items: flex-start; }\n.ys-preview .av { width: 20px; height: 20px; border-radius: 50%; flex: none; }\n.ys-preview .ln { height: 7px; border-radius: 4px; display: block; margin-bottom: 4px; }\n.ys-preview .in { position: absolute; left: 13px; right: 13px; bottom: 11px; height: 22px; border-radius: 9px; }\n.ys-credit-hero { display: flex; align-items: center; gap: 16px; padding: 22px; margin-bottom: 14px; border-radius: 16px; position: relative; overflow: hidden;\n  background: linear-gradient(120deg, color-mix(in srgb, var(--ys-accent) 30%, var(--ys-card)), color-mix(in srgb, var(--ys-accent2) 18%, var(--ys-card)) 65%, var(--ys-card)); border: 1px solid color-mix(in srgb, var(--ys-accent) 30%, transparent); }\n.ys-credit-logo { width: 58px; height: 58px; border-radius: 16px; display: grid; place-items: center; color: #fff; background: linear-gradient(135deg, var(--ys-accent), var(--ys-accent2)); box-shadow: 0 10px 28px color-mix(in srgb, var(--ys-accent) 45%, transparent); }\n.ys-credit-title { font-size: 22px; font-weight: 800; color: #fff; letter-spacing: -.01em; }\n.ys-people { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }\n.ys-person { display: flex; align-items: center; gap: 12px; background: var(--ys-card2); border: 1px solid var(--ys-line); border-radius: 12px; padding: 11px 12px; }\n.ys-person-av { width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; color: #fff; font-weight: 800; font-size: 15px; flex: none; }\n.ys-person-name { font-weight: 700; color: var(--ys-text); font-size: 13.5px; }\n.ys-log { display: flex; gap: 12px; align-items: baseline; padding: 8px 0; font-size: 13px; color: var(--ys-text); }\n.ys-log + .ys-log { border-top: 1px solid var(--ys-line); }\n.ys-log-v { flex: none; font-size: 11px; font-weight: 800; color: var(--ys-accent); background: color-mix(in srgb, var(--ys-accent) 12%, transparent); padding: 2px 8px; border-radius: 999px; }\n.ys-badges { display: inline-flex; align-items: center; gap: 3px; margin-left: 5px; vertical-align: -3px; }\n.ys-badge { width: 16px; height: 16px; object-fit: contain; user-select: none; border-radius: 3px; }\n.ys-pixel { image-rendering: pixelated; }\n.ys-badge-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(124px, 1fr)); gap: 8px; margin: 8px 0 14px; }\n.ys-badge-opt { display: flex; align-items: center; gap: 9px; background: var(--ys-card2); border: 1px solid var(--ys-line); border-radius: 10px; padding: 8px 10px; cursor: pointer; color: var(--ys-text); font-size: 12.5px; font-weight: 500; text-align: left; transition: border-color .12s, transform .12s; }\n.ys-badge-opt:hover { transform: translateY(-1px); border-color: var(--ys-line2); }\n.ys-badge-opt img { width: 22px; height: 22px; object-fit: contain; image-rendering: pixelated; }\n.ys-badge-opt.on { border-color: var(--ys-accent); background: color-mix(in srgb, var(--ys-accent) 12%, var(--ys-card2)); box-shadow: 0 0 0 1px var(--ys-accent) inset; }\n.ys-tagbox { font: 13px Consolas, monospace; background: var(--ys-bg); border: 1px dashed var(--ys-line2); border-radius: 9px; padding: 9px 11px; color: var(--ys-text); user-select: all; flex: 1; }\n#${d} { display: flex; align-items: center; gap: 8px; color: #ff8a5c; font-weight: 600; }\n#${d} svg { width: 18px; height: 18px; }\n#${u} { position: fixed; right: 20px; bottom: 90px; z-index: 2147483000; width: 296px; background: #1a1b20f7; color: #dbdee1; font-size: 13px; font-family: Inter, "Segoe UI", system-ui, sans-serif;\n  border: 1px solid #ffffff1a; border-radius: 16px; box-shadow: 0 20px 50px #000b; backdrop-filter: blur(14px); --ys-accent: #e27ed3; --ys-accent2: #ff4fa3; --ys-card2: #2a2b32; --ys-line: #ffffff0f; --ys-line2: #ffffff1a; --ys-text: #f2f3f5; --ys-mut: #9ea3ae; --ys-bg: #17181c; overflow: hidden; }\n#${u} header { display: flex; align-items: center; justify-content: space-between; padding: 12px 14px; cursor: move; font-weight: 700; color: #fff;\n  background: linear-gradient(120deg, color-mix(in srgb, var(--ys-accent) 38%, #1a1b20), #1a1b20); border-bottom: 1px solid #ffffff12; }\n#${u} header button { background: none; border: none; color: #ffffffa0; font-size: 18px; cursor: pointer; line-height: 1; }\n#${u} .q { padding: 8px 14px 13px; display: grid; gap: 2px; }\n#${u} .ys-range { min-width: 0; }\n#${u} .ys-select { width: 100%; margin: 6px 0; }\n#${u} .ys-row { padding: 8px 0; }\n#${u} .ys-row + .ys-row { border-top: 1px solid #ffffff0d; }\n#${f} { position: fixed; top: 8px; right: 12px; z-index: 2147482000; cursor: grab; user-select: none; color: #fff; font-family: Inter, "Segoe UI", system-ui, sans-serif;\n  --ck: 1; --ck-px: 4px; animation: ys-ck-in .35s cubic-bezier(.34,1.4,.64,1) both; }\n@keyframes ys-ck-in { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }\n#${f}.drag { cursor: grabbing; opacity: .92; }\n#${f}.ys-ck-s { --ck: .8; --ck-px: 3px; } #${f}.ys-ck-l { --ck: 1.3; --ck-px: 5px; }\n.ys-ck-main { display: flex; align-items: baseline; gap: calc(5px * var(--ck)); }\n.ys-ck-time { font-weight: 800; font-variant-numeric: tabular-nums; letter-spacing: -.02em; line-height: 1; }\n.ys-ck-sec { font-weight: 800; font-variant-numeric: tabular-nums; color: var(--ck-a); }\n.ys-ck-sec:empty, .ys-ck-ampm:empty { display: none; }\n.ys-ck-ampm { font-size: calc(10px * var(--ck)); font-weight: 900; letter-spacing: .08em; padding: 2px 6px; border-radius: 6px; color: #111; background: linear-gradient(135deg, var(--ck-a), var(--ck-a2)); align-self: center; }\n.ys-ck-date { display: none; font-size: calc(10.5px * var(--ck)); font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: #ffffff8c; margin-top: calc(5px * var(--ck)); }\n#${f}.dated .ys-ck-date { display: block; }\n.ys-ck-bar { display: none; }\n/* Boxed */\n.ys-ck-boxed { padding: calc(10px * var(--ck)) calc(14px * var(--ck)) calc(12px * var(--ck)); border-radius: calc(14px * var(--ck)); overflow: hidden;\n  background: radial-gradient(120% 140% at 0% 0%, color-mix(in srgb, var(--ck-a) 22%, transparent), transparent 60%), linear-gradient(160deg, #1f2028f0, #121318f5);\n  border: 1px solid color-mix(in srgb, var(--ck-a) 45%, #ffffff1a); box-shadow: 0 12px 30px #0009, 0 0 22px color-mix(in srgb, var(--ck-a) 22%, transparent), inset 0 1px 0 #ffffff17; backdrop-filter: blur(10px); }\n.ys-ck-boxed::before { content: ""; position: absolute; left: 0; top: 0; width: calc(26px * var(--ck)); height: 3px; border-radius: 0 0 3px 0; background: linear-gradient(90deg, var(--ck-a), var(--ck-a2)); }\n.ys-ck-boxed .ys-ck-time { font-size: calc(26px * var(--ck)); text-shadow: 0 0 18px color-mix(in srgb, var(--ck-a) 45%, transparent); }\n.ys-ck-boxed .ys-ck-sec { font-size: calc(13px * var(--ck)); }\n.ys-ck-boxed .ys-ck-bar { display: block; position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: #ffffff10; }\n.ys-ck-boxed .ys-ck-bar i { display: block; height: 100%; background: linear-gradient(90deg, var(--ck-a), var(--ck-a2)); box-shadow: 0 0 8px var(--ck-a); transition: width 1s linear; }\n/* Pixel */\n.ys-ck-pixel { padding: calc(9px * var(--ck)) calc(12px * var(--ck)) calc(10px * var(--ck)); background: #14151a; image-rendering: pixelated; border-radius: 0;\n  box-shadow: 0 0 0 calc(var(--ck-px) * .5) #000, 0 0 0 var(--ck-px) var(--ck-a), 0 0 0 calc(var(--ck-px) * 1.5) #000, calc(var(--ck-px) * 1.5) calc(var(--ck-px) * 1.5) 0 calc(var(--ck-px) * 1.5) #0008; }\n.ys-ck-pixel .ys-ck-main { gap: var(--ck-px); align-items: flex-end; }\n.ys-ck-pixel .ys-ck-time { color: #fff; filter: drop-shadow(var(--ck-px) 0 0 color-mix(in srgb, var(--ck-a) 55%, transparent)); line-height: 0; }\n.ys-ck-pixel .ys-ck-time svg, .ys-ck-pixel .ys-ck-sec svg { display: block; }\n.ys-ck-pixel .ys-ck-sec { line-height: 0; --ck-px: calc(2px * var(--ck)); }\n.ys-ck-pixel .ys-ck-ampm { border-radius: 0; font-family: Consolas, monospace; box-shadow: 0 0 0 2px #000; }\n.ys-ck-pixel .ys-ck-date { font-family: Consolas, "Courier New", monospace; letter-spacing: .14em; color: var(--ck-a); }\n.ys-ck-pixel .ys-ck-bar { display: flex; gap: 2px; margin-top: calc(6px * var(--ck)); height: var(--ck-px); background: repeating-linear-gradient(90deg, #ffffff14 0 calc(var(--ck-px) * 2), transparent 0 calc(var(--ck-px) * 2 + 2px)); }\n.ys-ck-pixel .ys-ck-bar i { display: block; height: 100%; background: repeating-linear-gradient(90deg, var(--ck-a) 0 calc(var(--ck-px) * 2), transparent 0 calc(var(--ck-px) * 2 + 2px)); }\n/* Pill (the classic look) */\n.ys-ck-pill { padding: calc(4px * var(--ck)) calc(11px * var(--ck)); border-radius: 999px; background: color-mix(in srgb, var(--bg-float, #1e1f22) 88%, transparent); border: 1px solid #ffffff1a; box-shadow: 0 4px 14px #0006; backdrop-filter: blur(8px); }\n.ys-ck-pill .ys-ck-time { font-size: calc(12.5px * var(--ck)); font-weight: 700; }\n.ys-ck-pill .ys-ck-sec { color: inherit; opacity: .7; font-size: calc(12.5px * var(--ck)); font-weight: 700; margin-left: -4px; }\n.ys-ck-pill .ys-ck-ampm { font-size: calc(9px * var(--ck)); padding: 1px 5px; }\n/* ---- Studio redesign ---- */\n#${p} .ys-card { position: relative; transition: border-color .2s, box-shadow .2s; }\n#${p}.ys-glow .ys-card::before { content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; opacity: 0; transition: opacity .3s;\n  background: radial-gradient(560px circle at var(--mx, 50%) var(--my, 50%), color-mix(in srgb, var(--ys-accent) 8%, transparent), transparent 45%); }\n#${p}.ys-glow .ys-card::after { content: ""; position: absolute; inset: -1px; border-radius: inherit; padding: 1px; pointer-events: none; opacity: 0; transition: opacity .3s;\n  background: radial-gradient(320px circle at var(--mx, 50%) var(--my, 50%), color-mix(in srgb, var(--ys-accent) 90%, transparent), transparent 55%);\n  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; }\n#${p}.ys-glow .ys-card:hover::before, #${p}.ys-glow .ys-card:hover::after { opacity: 1; }\n#${p} .ys-card:hover { box-shadow: 0 1px 0 #ffffff08 inset, 0 14px 36px #00000040, 0 0 34px color-mix(in srgb, var(--ys-accent) 7%, transparent); }\n.ys-side-ind { position: absolute; left: 10px; right: 10px; top: 0; height: 36px; border-radius: 10px; pointer-events: none; opacity: 0; z-index: 0;\n  background: linear-gradient(90deg, color-mix(in srgb, var(--ys-accent) 22%, var(--ys-card)), color-mix(in srgb, var(--ys-accent2) 10%, var(--ys-card)));\n  box-shadow: 0 0 0 1px color-mix(in srgb, var(--ys-accent) 30%, transparent), 0 6px 20px color-mix(in srgb, var(--ys-accent) 20%, transparent);\n  transition: transform .34s cubic-bezier(.34,1.32,.64,1), height .2s, opacity .2s; }\n.ys-side-ind.on { opacity: 1; }\n.ys-side-ind::before { content: ""; position: absolute; left: -10px; top: 7px; bottom: 7px; width: 3px; border-radius: 0 3px 3px 0; background: linear-gradient(var(--ys-accent), var(--ys-accent2)); box-shadow: 0 0 10px var(--ys-accent); }\n.ys-side { position: sticky; }\n.ys-side-item { position: relative; z-index: 1; transition: color .15s, background .15s; }\n.ys-side-item.on, .ys-side-item.on:hover { background: transparent; }\n.ys-side-item.on::before { display: none; }\n.ys-side-item:hover:not(.on) { background: color-mix(in srgb, var(--ys-card) 80%, transparent); box-shadow: inset 0 0 0 1px var(--ys-line); }\n@media (max-width: 760px) { .ys-side-ind { display: none; } .ys-side-item.on { background: color-mix(in srgb, var(--ys-accent) 13%, var(--ys-card)); } }\n.ys-switch input:checked + i { box-shadow: 0 0 14px color-mix(in srgb, var(--ys-accent) 55%, transparent), inset 0 1px 2px #0003; }\n.ys-switch:hover i { filter: brightness(1.1); }\n.ys-btn { position: relative; overflow: hidden; display: inline-flex; align-items: center; gap: 6px; }\n.ys-btn svg { flex: none; }\n.ys-btn::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(105deg, transparent 35%, #ffffff40 50%, transparent 65%); transform: translateX(-130%); transition: transform .55s ease; }\n.ys-btn:hover::after { transform: translateX(130%); }\n.ys-btn:not(.ghost):hover { box-shadow: 0 6px 20px color-mix(in srgb, var(--ys-accent) 40%, transparent); }\n.ys-btn.ghost:hover { border-color: color-mix(in srgb, var(--ys-accent) 45%, var(--ys-line2)); }\n.ys-logo { animation: ys-logo-glow 4s ease-in-out infinite; }\n@keyframes ys-logo-glow { 0%, 100% { box-shadow: 0 6px 18px color-mix(in srgb, var(--ys-accent) 35%, transparent); } 50% { box-shadow: 0 6px 26px color-mix(in srgb, var(--ys-accent) 65%, transparent); } }\n.ys-page-icon { box-shadow: 0 0 22px color-mix(in srgb, var(--ys-accent) 22%, transparent); }\n.ys-text:focus, .ys-select:focus, .ys-area:focus { outline: none; border-color: var(--ys-accent) !important; box-shadow: 0 0 0 3px color-mix(in srgb, var(--ys-accent) 22%, transparent); }\n.ys-preset:hover { box-shadow: 0 0 0 1px color-mix(in srgb, var(--ys-accent) 45%, transparent), 0 10px 26px color-mix(in srgb, var(--ys-accent) 18%, transparent); }\n/* ---- Pixel Studio page ---- */\n.ys-px-hero { display: grid; grid-template-columns: auto 1fr; gap: 22px; align-items: center; padding: 20px 22px; border-radius: 18px; margin-bottom: 12px;\n  background: radial-gradient(120% 140% at 0% 0%, color-mix(in srgb, var(--ys-accent) 20%, transparent), transparent 55%), var(--ys-card); border: 1px solid color-mix(in srgb, var(--ys-accent) 32%, var(--ys-line)); }\n.ys-px-art { width: 108px; height: 108px; display: grid; grid-template-columns: repeat(6, 1fr); gap: 2px; padding: 6px; border-radius: 14px; background: #0005; border: 1px solid #ffffff1f; }\n.ys-px-art i { border-radius: 2px; background: #ffffff10; animation: ys-px-blink 3.2s ease-in-out infinite; }\n.ys-px-art i:nth-child(3n) { background: var(--ys-accent); animation-delay: .4s; } .ys-px-art i:nth-child(5n) { background: var(--ys-accent2); animation-delay: .9s; } .ys-px-art i:nth-child(7n) { background: #ffd23f; animation-delay: 1.4s; }\n@keyframes ys-px-blink { 50% { opacity: .55; } }\n.px-presets { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 10px; }\n.px-preset { display: grid; justify-items: center; gap: 3px; padding: 14px 10px 12px; border-radius: 14px; border: 1px solid var(--ys-line, #ffffff14); background: var(--ys-card2, #2a2b32); color: var(--ys-text, #eee); cursor: pointer; font: inherit; text-align: center; transition: transform .15s, border-color .15s, box-shadow .15s; }\n.px-preset:hover { transform: translateY(-2px); border-color: color-mix(in srgb, var(--ys-accent, #ff6b4a) 55%, transparent); box-shadow: 0 10px 24px color-mix(in srgb, var(--ys-accent, #ff6b4a) 18%, transparent); }\n.px-preset b { font-size: 13px; } .px-preset span { font-size: 11.5px; color: var(--ys-accent, #ff6b4a); font-weight: 800; } .px-preset small { font-size: 11px; color: var(--ys-mut, #9ea3ae); line-height: 1.3; }\n.px-preset-art { height: 76px; display: grid; place-items: center; }\n.px-preset-art i { display: block; border-radius: 4px; background: repeating-conic-gradient(#ffffff16 0 25%, transparent 0 50%) 0 0 / 10px 10px, #0006; border: 1.5px solid color-mix(in srgb, var(--ys-accent, #ff6b4a) 60%, transparent); position: relative; }\n.px-preset-art i.ring::after { content: ""; position: absolute; inset: 17%; border-radius: 50%; border: 1.5px dashed #ffffff80; }\n.px-custom { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 12px; font-size: 12.5px; color: var(--ys-mut, #9ea3ae); font-weight: 700; }\n.px-custom input { width: 70px; padding: 7px 8px; border-radius: 8px; border: 1px solid var(--ys-line2, #ffffff22); background: var(--ys-bg, #17181c); color: #fff; font: inherit; }\n.ys-px-projects { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 10px; }\n.ys-px-proj { display: grid; gap: 8px; padding: 10px; border-radius: 14px; background: var(--ys-card2); border: 1px solid var(--ys-line); }\n.ys-px-thumb { height: 120px; border-radius: 10px; border: 0; padding: 0; cursor: pointer; display: grid; place-items: center; overflow: hidden; background: repeating-conic-gradient(#ffffff0d 0 25%, transparent 0 50%) 0 0 / 14px 14px, #0005; }\n.ys-px-thumb img { max-width: 100%; max-height: 100%; image-rendering: pixelated; }\n.ys-px-thumb:hover { box-shadow: inset 0 0 0 2px var(--ys-accent); }\n.ys-plus-list { display: grid; gap: 8px; }\n.ys-plus-item { display: grid; gap: 2px; padding: 10px 12px; border-radius: 12px; background: var(--ys-card2, #2a2b32); border: 1px solid var(--ys-line, #ffffff14); }\n.ys-plus-item b { font-size: 13px; } .ys-plus-item span { font-size: 12px; color: var(--ys-mut, #9ea3ae); line-height: 1.4; }\n/* ---- the editor ---- */\n#yapstudio-pixel { position: fixed; inset: 0; z-index: 2147483300; display: grid; grid-template-rows: auto auto minmax(0, 1fr) auto auto; background: #0f1014; color: #e8e9ee; outline: none;\n  font: 13px Inter, "Segoe UI", system-ui, sans-serif; --pa: var(--accent, #ff6b4a); --pl: #ffffff12; --pb: #16171c; --pc: #1c1d23; animation: ys-px-in .25s ease both; }\n@keyframes ys-px-in { from { opacity: 0; transform: scale(.985); } to { opacity: 1; transform: none; } }\n#yapstudio-pixel *, #yapstudio-pixel *::before, #yapstudio-pixel *::after { box-sizing: border-box; }\n#yapstudio-pixel button { font-family: inherit; }\n:where(#yapstudio-pixel) input[type=text], :where(#yapstudio-pixel) input[type=number] { display: inline-block; margin: 0; box-shadow: none; line-height: normal; }   /* the website's own input look stays out of the editor */\n#yapstudio-pixel ::-webkit-scrollbar { width: 9px; height: 9px; } #yapstudio-pixel ::-webkit-scrollbar-thumb { background: #ffffff1c; border-radius: 9px; border: 2px solid transparent; background-clip: padding-box; }\n/* top bar: brand, menus, name, quick buttons */\n.px-top { display: flex; align-items: center; gap: 3px; padding: 6px 10px; background: linear-gradient(180deg, #1c1d24, #17181d); border-bottom: 1px solid var(--pl); overflow-x: auto; scrollbar-width: none; min-width: 0; }\n.px-brand { display: flex; align-items: center; gap: 8px; padding: 0 8px 0 2px; color: var(--pa); white-space: nowrap; flex: none; }\n.px-brand b { color: #fff; font-size: 14px; letter-spacing: -.01em; }\n.px-menus { display: flex; gap: 1px; flex: none; }\n.px-menu-btn { height: 30px; padding: 0 10px; border: 0; border-radius: 8px; background: none; color: #c4c7d0; font-weight: 600; font-size: 13px; cursor: pointer; white-space: nowrap; }\n.px-menu-btn:hover, .px-menu-btn.open { background: #ffffff14; color: #fff; }\n#yapstudio-pixel .px-name { width: 160px; padding: 6px 10px; border-radius: 9px; border: 1px solid #ffffff1a; background: #0d0e12; color: #fff; font-weight: 600; font-size: 13px; font-family: inherit; flex: none; }\n#yapstudio-pixel .px-name:focus { outline: none; border-color: var(--pa); }\n.px-sep { width: 1px; height: 22px; background: #ffffff18; margin: 0 5px; flex: none; }\n.px-flex { flex: 1; min-width: 8px; }\n.px-btn { display: inline-flex; align-items: center; gap: 6px; height: 32px; padding: 0 8px; border-radius: 9px; border: 0; background: none; color: #c4c7d0; cursor: pointer; font-weight: 600; font-size: 13px; font-family: inherit; white-space: nowrap; flex: none; transition: background .12s, color .12s, opacity .12s; }\n.px-btn:hover { background: #ffffff12; color: #fff; }\n.px-btn.on { color: #fff; background: color-mix(in srgb, var(--pa) 30%, transparent); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--pa) 60%, transparent); }\n.px-btn.dim { opacity: .38; }\n.px-export { background: var(--pa); color: #14100e; font-weight: 800; padding: 0 12px; margin-left: 4px; }\n.px-export:hover { background: var(--pa); color: #000; filter: brightness(1.1); box-shadow: 0 6px 18px color-mix(in srgb, var(--pa) 40%, transparent); }\n.px-close:hover { background: #ff4b5c26; color: #ff8a95; }\n.px-savestate { font-size: 11.5px; font-weight: 800; color: #6fd6a0; padding: 3px 9px; border-radius: 99px; background: #2fd07a18; white-space: nowrap; flex: none; margin-right: 4px; }\n.px-savestate.dirty { color: #ffc078; background: #ffa94d18; }\n/* menus */\n.px-menu { position: absolute; z-index: 8; min-width: 240px; max-height: calc(100% - 20px); overflow-y: auto; padding: 5px; border-radius: 12px; background: #202128f5; border: 1px solid #ffffff1f; box-shadow: 0 18px 50px #000b; backdrop-filter: blur(8px); animation: px-menu-in .12s ease-out both; }\n@keyframes px-menu-in { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }\n.px-menu-item { display: grid; grid-template-columns: 18px 1fr auto; align-items: center; gap: 8px; width: 100%; padding: 7px 10px 7px 8px; border: 0; border-radius: 8px; background: none; color: #e3e4ea; font-size: 13px; text-align: left; cursor: pointer; }\n.px-menu-item:hover { background: color-mix(in srgb, var(--pa) 26%, transparent); color: #fff; }\n.px-menu-item.dis { opacity: .4; pointer-events: none; }\n.px-menu-item kbd { font: 700 11px Consolas, monospace; color: #8b8f9c; }\n.px-menu-check { display: grid; place-items: center; color: var(--pa); }\n.px-menu-sep { height: 1px; background: #ffffff14; margin: 5px 6px; }\n.px-menu-head { padding: 8px 10px 4px; font-size: 10px; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; color: #7d8190; }\n/* tool options bar */\n.px-optbar { display: flex; flex-wrap: wrap; align-items: center; gap: 5px 8px; min-height: 42px; padding: 5px 12px; background: var(--pb); border-bottom: 1px solid var(--pl); min-width: 0; }\n.px-oname { display: flex; align-items: center; gap: 7px; color: var(--pa); flex: none; }\n.px-oname b { color: #fff; font-size: 13px; white-space: nowrap; }\n.px-osep { width: 1px; height: 22px; background: #ffffff16; flex: none; }\n.px-size { display: flex; align-items: center; gap: 5px; flex: none; font-size: 12px; font-weight: 700; color: #9ea3ae; }\n.px-size button { width: 24px; height: 24px; border-radius: 7px; border: 0; background: #ffffff12; color: #fff; cursor: pointer; font-weight: 900; font-size: 14px; line-height: 1; }\n.px-size button:hover { background: #ffffff22; }\n.px-size input, .px-oslider input { width: 96px; accent-color: var(--pa); }\n.px-size b, .px-oslider b { min-width: 26px; text-align: center; color: #fff; font-size: 12.5px; font-variant-numeric: tabular-nums; }\n.px-oslider { display: flex; align-items: center; gap: 6px; flex: none; font-size: 12px; font-weight: 700; color: #9ea3ae; }\n.px-oseg { display: flex; gap: 2px; padding: 2px; border-radius: 9px; background: #0d0e12; flex: none; }\n.px-oseg button { border: 0; background: none; color: #a9adba; font-weight: 700; font-size: 12px; padding: 5px 9px; border-radius: 7px; cursor: pointer; white-space: nowrap; }\n.px-oseg button:hover { color: #fff; }\n.px-oseg button.on { color: #fff; background: color-mix(in srgb, var(--pa) 70%, #000); }\n.px-chip { flex: none; white-space: nowrap; }\n.px-ohint { flex: 1 1 120px; min-width: 60px; font-size: 11.5px; color: #757a87; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.px-protect { display: inline-flex; align-items: center; gap: 6px; height: 30px; padding: 0 11px; border-radius: 99px; border: 1px solid #ff4f8b55; background: #ff4f8b12; color: #ff9cbc; font-weight: 800; font-size: 12px; cursor: pointer; white-space: nowrap; flex: none; transition: background .12s, box-shadow .12s; }\n.px-protect:hover { background: #ff4f8b24; }\n.px-protect.on { background: #ff4f8b; border-color: #ff4f8b; color: #1a0710; box-shadow: 0 4px 16px #ff4f8b55; }\n/* body: tool rail, stage, panels */\n.px-body { display: grid; grid-template-columns: 82px minmax(0, 1fr) 300px; min-height: 0; }\n.px-tools { display: grid; grid-template-columns: repeat(2, 34px); justify-content: center; align-content: start; gap: 3px; padding: 8px 0; background: var(--pb); border-right: 1px solid var(--pl); overflow-y: auto; scrollbar-width: none; }\n.px-tool { width: 34px; height: 34px; display: grid; place-items: center; border-radius: 10px; border: 0; background: none; color: #a9adba; cursor: pointer; transition: background .12s, color .12s, box-shadow .12s, transform .12s; }\n.px-tool:hover { background: #ffffff10; color: #fff; }\n.px-tool:active { transform: scale(.94); }\n.px-tool.on { color: #fff; background: linear-gradient(135deg, var(--pa), color-mix(in srgb, var(--pa) 60%, #ff4fa3)); box-shadow: 0 4px 14px color-mix(in srgb, var(--pa) 45%, transparent); }\n.px-tsep { grid-column: 1 / -1; height: 1px; background: #ffffff14; margin: 4px 6px; }\n.px-railcols { grid-column: 1 / -1; position: relative; width: 56px; height: 50px; margin: 10px auto 4px; border: 0; padding: 0; background: none; cursor: pointer; }\n.px-railcols i { position: absolute; width: 32px; height: 32px; border-radius: 8px; border: 2px solid #ffffffd0; box-shadow: 0 3px 10px #0008; }\n.px-rc1 { left: 0; top: 0; z-index: 1; } .px-rc2 { right: 0; bottom: 0; border-color: #ffffff70 !important; }\n.px-stage { position: relative; overflow: hidden; background: radial-gradient(circle at 50% 40%, #1a1b21, #0c0d10); cursor: crosshair; }\n.px-view { position: absolute; inset: 0; display: block; touch-action: none; }\n#yapstudio-pixel.t-hand .px-stage, #yapstudio-pixel.space .px-stage { cursor: grab; }\n#yapstudio-pixel.panning .px-stage { cursor: grabbing; }\n.px-pill { position: absolute; right: 12px; bottom: 12px; display: flex; align-items: center; gap: 1px; padding: 4px; border-radius: 13px; background: #1d1e25e8; border: 1px solid #ffffff18; box-shadow: 0 10px 30px #0009; backdrop-filter: blur(8px); z-index: 2; }\n.px-pill .px-btn { height: 30px; padding: 0 7px; }\n.px-psep { width: 1px; height: 18px; background: #ffffff1c; margin: 0 3px; }\n.px-zoom { min-width: 56px; height: 30px; border: 0; border-radius: 8px; background: none; text-align: center; font-weight: 800; font-size: 12px; color: #fff; font-variant-numeric: tabular-nums; cursor: pointer; }\n.px-zoom:hover, .px-zoom.open { background: #ffffff14; }\n.px-selbar { position: absolute; left: 50%; top: 10px; transform: translateX(-50%); display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 3px; max-width: calc(100% - 24px); padding: 4px; border-radius: 12px; background: #1d1e25eb; border: 1px solid #ffffff18; box-shadow: 0 10px 30px #0009; backdrop-filter: blur(8px); z-index: 2; animation: px-menu-in .15s ease-out both; }\n.px-selbar .px-mini { padding: 5px 8px; }\n.px-selsize { padding: 0 8px; font-size: 11.5px; font-weight: 800; color: var(--pa); white-space: nowrap; font-variant-numeric: tabular-nums; }\n.px-bsep { width: 1px; height: 16px; background: #ffffff1c; margin: 0 2px; }\n.px-dropnote { position: absolute; inset: 14px; display: none; place-content: center; justify-items: center; gap: 6px; border: 2px dashed color-mix(in srgb, var(--pa) 70%, transparent); border-radius: 18px; background: #0f1014cc; color: var(--pa); z-index: 3; pointer-events: none; }\n.px-dropnote b { color: #fff; font-size: 16px; } .px-dropnote span { color: #9ea3ae; }\n#yapstudio-pixel.px-dropping .px-dropnote { display: grid; }\n.px-side { display: flex; flex-direction: column; gap: 8px; padding: 8px; background: var(--pb); border-left: 1px solid var(--pl); overflow-y: auto; min-height: 0; }\n.px-panel { padding: 10px 12px 12px; border-radius: 13px; background: var(--pc); border: 1px solid #ffffff10; flex: none; }\n.px-panel.folded { padding-bottom: 10px; }\n.px-panel.folded .px-h { margin-bottom: 0; }\n.px-grow { flex: 1 0 auto; display: flex; flex-direction: column; min-height: 220px; }\n.px-grow.folded { min-height: 0; flex: none; }\n.px-h { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-size: 10.5px; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; color: #8b8f9c; margin-bottom: 10px; min-height: 24px; }\n.px-fold { cursor: pointer; user-select: none; }\n.px-htitle { display: inline-flex; align-items: center; gap: 5px; }\n.px-htitle svg { transition: transform .15s; opacity: .7; }\n.px-fold.shut .px-htitle svg { transform: rotate(-90deg); }\n.px-fold:hover .px-htitle { color: #c9ccd6; }\n.px-hbtns { display: flex; align-items: center; gap: 4px; }\n.px-icbtn { padding: 4px 6px; }\n.px-cols { display: flex; gap: 12px; align-items: center; }\n.px-pair { position: relative; width: 70px; height: 62px; flex: none; }\n.px-sw { position: absolute; width: 44px; height: 44px; border-radius: 10px; border: 2px solid #ffffffd0; box-shadow: 0 4px 12px #0008; cursor: pointer; overflow: hidden; }\n.px-sw input { opacity: 0; width: 100%; height: 100%; cursor: pointer; }\n.px-sw-c1 { left: 0; top: 0; z-index: 1; } .px-sw-c2 { right: 0; bottom: 0; border-color: #ffffff70; }\n.px-colmeta { display: grid; grid-template-columns: minmax(0, 1fr); gap: 6px; flex: 1; min-width: 0; }\n#yapstudio-pixel .px-hex { width: 100%; padding: 7px 9px; border-radius: 8px; border: 1px solid #ffffff1a; background: #0d0e12; color: #fff; font: 700 12.5px Consolas, monospace; text-transform: lowercase; }\n.px-hsv { display: grid; gap: 6px; margin-top: 10px; }\n.px-sv { width: 100%; height: 112px; border-radius: 9px; cursor: crosshair; display: block; touch-action: none; }\n.px-hue { width: 100%; height: 14px; border-radius: 7px; cursor: ew-resize; display: block; touch-action: none; }\n.px-mini { display: inline-flex; align-items: center; justify-content: center; gap: 5px; padding: 6px 8px; border-radius: 8px; border: 0; background: #ffffff10; color: #d6d8df; cursor: pointer; font-weight: 700; font-size: 11.5px; font-family: inherit; }\n.px-mini:hover { background: #ffffff20; color: #fff; }\n.px-recent { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 10px; }\n.px-dot { width: 20px; height: 20px; border-radius: 6px; border: 1px solid #ffffff2a; cursor: pointer; padding: 0; }\n.px-dot.big { width: 100%; height: 26px; }\n.px-dot:hover { transform: scale(1.12); box-shadow: 0 0 0 2px #fff; }\n.px-add { background: #ffffff0d !important; color: #fff; font-weight: 900; font-size: 15px; }\n.px-pal { display: grid; grid-template-columns: repeat(8, 1fr); gap: 4px; }\n.px-palbtns { margin-bottom: 8px; }\n.px-sel { padding: 5px 8px; border-radius: 8px; border: 1px solid #ffffff1a; background: #0d0e12; color: #fff; font-weight: 600; font-size: 12px; font-family: inherit; text-transform: none; letter-spacing: 0; max-width: 150px; }\n.px-lbtns { display: flex; gap: 2px; }\n.px-lbtns .px-mini { padding: 5px; }\n.px-layers { display: grid; gap: 4px; align-content: start; overflow-y: auto; flex: 1; min-height: 60px; }\n.px-layer { display: flex; align-items: center; gap: 6px; padding: 5px 6px; border-radius: 9px; border: 1px solid transparent; cursor: grab; transition: background .12s; }\n.px-layer:hover { background: #ffffff08; }\n.px-layer.on { background: color-mix(in srgb, var(--pa) 16%, transparent); border-color: color-mix(in srgb, var(--pa) 50%, transparent); }\n.px-layer.hidden-l .px-lthumb, .px-layer.hidden-l .px-lname { opacity: .45; }\n.px-dragging { opacity: .45; }\n.px-drop-before { box-shadow: 0 -2px 0 var(--pa) !important; } .px-frame.px-drop-before { box-shadow: -3px 0 0 var(--pa) !important; }\n.px-drop-after { box-shadow: 0 2px 0 var(--pa) !important; } .px-frame.px-drop-after { box-shadow: 3px 0 0 var(--pa) !important; }\n.px-eye { width: 26px; height: 26px; display: grid; place-items: center; border: 0; border-radius: 7px; background: none; color: #c4c7d0; cursor: pointer; flex: none; }\n.px-eye:hover { background: #ffffff10; }\n.px-eye.off { color: #6a6e7a; }\n.px-lthumb { width: 46px; height: 30px; object-fit: contain; image-rendering: pixelated; border-radius: 5px; background: repeating-conic-gradient(#ffffff14 0 25%, transparent 0 50%) 0 0 / 8px 8px, #0006; flex: none; }\n#yapstudio-pixel .px-lname { flex: 1; min-width: 0; padding: 4px 6px; border-radius: 6px; border: 1px solid transparent; background: none; color: #e8e9ee; font-weight: 600; font-size: 12.5px; font-family: inherit; }\n#yapstudio-pixel .px-lname:focus { outline: none; border-color: #ffffff30; background: #0d0e12; }\n.px-lblend { font-size: 9.5px; font-weight: 900; text-transform: uppercase; color: var(--pa); padding: 2px 5px; border-radius: 5px; background: #ffffff0c; flex: none; }\n.px-op { display: flex; align-items: center; gap: 8px; margin-top: 10px; font-size: 11.5px; font-weight: 700; color: #8b8f9c; }\n.px-op > span:first-child { width: 48px; flex: none; }\n.px-op input { flex: 1; accent-color: var(--pa); }\n.px-blend { margin-top: 6px; } .px-blend .px-sel { flex: 1; max-width: none; }\n.px-status { padding: 5px 14px; font-size: 11.5px; color: #8b8f9c; background: var(--pb); border-top: 1px solid var(--pl); font-variant-numeric: tabular-nums; white-space: pre; overflow: hidden; text-overflow: ellipsis; }\n.px-modal { position: absolute; inset: 0; z-index: 9; display: grid; place-items: center; background: #05060899; backdrop-filter: blur(2px); }\n.px-dlg { width: 440px; max-width: calc(100vw - 32px); max-height: calc(100vh - 40px); overflow: auto; padding: 18px; border-radius: 18px; background: #1d1e24; border: 1px solid #ffffff1a; box-shadow: 0 30px 80px #000c; animation: ys-un-pop .3s cubic-bezier(.34,1.5,.64,1) both; }\n.px-dlg.wide { width: 760px; }\n.px-dlg-h { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }\n.px-dlg-h b { font-size: 16px; color: #fff; }\n.px-exp { display: grid; gap: 12px; }\n.px-seg { display: flex; gap: 4px; padding: 3px; border-radius: 10px; background: #0d0e12; width: max-content; }\n.px-seg button { border: 0; background: none; color: #a9adba; font-weight: 800; font-size: 13px; font-family: inherit; padding: 8px 14px; border-radius: 8px; cursor: pointer; }\n.px-seg button.on { color: #fff; background: var(--pa); }\n.px-exp-sz { font-size: 13px; font-weight: 800; color: #fff; }\n.px-adj { display: grid; grid-template-columns: 90px 1fr 44px; align-items: center; gap: 10px; font-size: 12.5px; font-weight: 700; color: #c9ccd6; }\n.px-adj input { accent-color: var(--pa); } .px-adj b { text-align: right; color: #fff; font-variant-numeric: tabular-nums; }\n.px-tips { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }\n.px-tip { display: grid; gap: 4px; padding: 12px; border-radius: 12px; background: #ffffff08; border: 1px solid #ffffff10; font-size: 12.5px; line-height: 1.45; color: #b9bdc8; }\n.px-tip b { color: #fff; font-size: 13px; }\n.px-mini.on { color: #fff; background: color-mix(in srgb, var(--pa) 35%, transparent); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--pa) 65%, transparent); }\n.px-hsub { font-weight: 700; letter-spacing: 0; text-transform: none; color: #6f7380; }\n.px-prevbox { display: grid; place-items: center; min-height: 70px; padding: 8px; border-radius: 10px; background: repeating-conic-gradient(#ffffff0e 0 25%, transparent 0 50%) 0 0 / 12px 12px, #0d0e12; }\n.px-prevbox.bg1 { background: #1e1f22; } .px-prevbox.bg2 { background: #f2f3f5; }\n.px-prev { display: block; image-rendering: pixelated; max-width: 100%; }\n.px-hint { font-size: 11.5px; color: #8b8f9c; margin: 4px 0 8px; line-height: 1.4; }\n.px-opts { display: flex; flex-wrap: wrap; gap: 4px; }\n.px-shades { display: grid; grid-template-columns: repeat(7, 1fr); gap: 3px; margin-top: 10px; }\n.px-shades .px-dot.mid { box-shadow: 0 0 0 2px #fff; }\n.px-anchor { display: grid; grid-template-columns: repeat(3, 14px); gap: 3px; margin: 0 6px; }\n.px-anchor button { width: 14px; height: 14px; padding: 0; border: 1px solid #ffffff30; background: #0d0e12; border-radius: 3px; cursor: pointer; }\n.px-anchor button.on { background: var(--pa); border-color: var(--pa); }\n#yapstudio-pixel .px-text-in { text-transform: none; font-family: inherit; font-size: 14px; }\n.px-text-box { display: grid; place-items: center; min-height: 64px; padding: 12px; border-radius: 10px; background: repeating-conic-gradient(#ffffff0e 0 25%, transparent 0 50%) 0 0 / 12px 12px, #0d0e12; overflow: auto; }\n.px-text-prev { image-rendering: pixelated; height: 40px; width: auto; max-width: 100%; object-fit: contain; }\n.px-lock { opacity: .55; } .px-lock.on { opacity: 1; color: var(--pa); }\n.px-keys { display: grid; grid-template-columns: auto 1fr auto 1fr; gap: 7px 14px; align-items: center; font-size: 12.5px; color: #c9ccd6; }\n.px-keys kbd { justify-self: start; padding: 3px 8px; border-radius: 6px; background: #0d0e12; border: 1px solid #ffffff22; border-bottom-width: 2px; font: 700 11.5px Consolas, monospace; color: #fff; white-space: nowrap; }\n/* timeline */\n.px-timeline { display: flex; align-items: center; gap: 8px; padding: 7px 10px; background: #14151a; border-top: 1px solid var(--pl); min-width: 0; }\n.px-tl-ctrl { display: flex; align-items: center; gap: 2px; flex: none; }\n.px-tl-ctrl .px-btn { height: 32px; padding: 0 7px; }\n.px-play { background: var(--pa) !important; color: #111 !important; width: 38px; justify-content: center; }\n.px-play:hover { filter: brightness(1.12); }\n.px-frames { flex: 1; min-width: 0; display: flex; gap: 6px; overflow-x: auto; padding: 2px 4px; scrollbar-width: thin; }\n.px-frame { position: relative; flex: none; display: grid; justify-items: center; gap: 2px; padding: 4px 4px 3px; border-radius: 10px; border: 1.5px solid #ffffff14; background: #1d1e24; color: #9ea3ae; cursor: grab; font-family: inherit; transition: border-color .12s, background .12s; }\n.px-frame:hover { border-color: #ffffff38; }\n.px-frame.on { border-color: var(--pa); background: color-mix(in srgb, var(--pa) 16%, #1d1e24); color: #fff; box-shadow: 0 0 12px color-mix(in srgb, var(--pa) 30%, transparent); }\n.px-fthumb { display: block; max-height: 46px; image-rendering: pixelated; border-radius: 4px; background: repeating-conic-gradient(#ffffff14 0 25%, transparent 0 50%) 0 0 / 8px 8px, #0006; }\n.px-frame span { position: absolute; top: 2px; left: 5px; font-size: 10px; font-weight: 900; text-shadow: 0 1px 2px #000; }\n.px-frame small { font-size: 9.5px; font-weight: 700; }\n.px-durbox { display: flex; align-items: center; gap: 4px; margin-left: 6px; font-size: 11.5px; color: #8b8f9c; font-weight: 700; }\n#yapstudio-pixel .px-dur { width: 66px; padding: 6px 7px; border-radius: 8px; border: 1px solid #ffffff1a; background: #0d0e12; color: #fff; font-family: inherit; font-weight: 700; }\n.px-fps { margin-left: 8px; font-size: 11.5px; color: #8b8f9c; font-weight: 700; white-space: nowrap; }\n/* round 4 polish */\n.px-layers { overflow-x: hidden; grid-template-columns: minmax(0, 1fr); } .px-layer { min-width: 0; } #yapstudio-pixel .px-lname { width: 0; }\n.px-tool { position: relative; }\n.px-tool::after { content: attr(data-key); position: absolute; right: 3px; bottom: 2px; font: 800 8px/1 Consolas, monospace; color: #ffffff4d; text-transform: uppercase; pointer-events: none; }\n.px-tool.on::after { color: #ffffffb0; }\n#yapstudio-pixel .px-status { display: flex; align-items: center; gap: 5px; white-space: nowrap; padding: 4px 10px; }\n.px-st { padding: 2px 9px; border-radius: 99px; background: #ffffff08; flex: none; } .px-st.b { color: #d6d8df; font-weight: 700; } .px-st.warn { color: #ffc078; background: #ffa94d14; } .px-st.prot { color: #ff9cbc; background: #ff4f8b14; }\n.px-selbar { top: 28px; }\n.px-history { display: grid; gap: 1px; max-height: 230px; overflow-y: auto; }\n.px-hist { text-align: left; padding: 5px 9px; border: 0; border-radius: 7px; background: none; color: #c9ccd6; font-size: 12px; cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.px-hist:hover { background: #ffffff0f; color: #fff; }\n.px-hist.cur { background: color-mix(in srgb, var(--pa) 22%, transparent); color: #fff; font-weight: 700; }\n.px-hist.redo { color: #676b78; }\n.px-prev { cursor: crosshair; touch-action: none; }\n.px-menu-item:focus { outline: none; background: color-mix(in srgb, var(--pa) 26%, transparent); color: #fff; }\n.px-tool, .px-btn, .px-mini, .px-chip, .px-oseg button, .px-menu-btn { -webkit-tap-highlight-color: transparent; }\n.px-tool:focus-visible, .px-btn:focus-visible, .px-mini:focus-visible, .px-menu-btn:focus-visible { outline: 2px solid color-mix(in srgb, var(--pa) 70%, transparent); outline-offset: 1px; }\n.px-panel { transition: border-color .15s; } .px-panel:hover { border-color: #ffffff18; }\n/* Customization+ and cloud */\n#yapstudio-pixel:not(.px-plus) [data-plus] { display: none !important; }\n.px-osel { padding: 5px 8px; border-radius: 8px; border: 1px solid #ffffff1a; background: #0d0e12; color: #fff; font: 600 12px inherit; font-family: inherit; flex: none; max-width: 170px; }\n.px-ltag { width: 10px; height: 26px; border: 0; border-radius: 4px; padding: 0; cursor: pointer; flex: none; background: #ffffff14; }\n.px-ltag.t1 { background: #ff6b6b; } .px-ltag.t2 { background: #ffa94d; } .px-ltag.t3 { background: #ffd43b; } .px-ltag.t4 { background: #51cf66; } .px-ltag.t5 { background: #4dabf7; } .px-ltag.t6 { background: #b197fc; }\n.px-flock { width: 24px; height: 24px; display: grid; place-items: center; border: 0; border-radius: 7px; background: none; color: #6a6e7a; cursor: pointer; flex: none; }\n.px-flock.on { color: #ff8a95; background: #ff4b5c1f; }\n.px-expplus, .px-mysizes { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }\n.px-mysizes { margin-top: 10px; font-size: 12px; font-weight: 700; color: var(--ys-mut, #9ea3ae); }\n.px-edsec { padding: 12px; border-radius: 12px; background: #ffffff06; border: 1px solid #ffffff0f; }\n.px-edgrid { display: grid; grid-template-columns: minmax(150px, 1fr) auto; gap: 8px 14px; align-items: center; }\n.px-edl { font-size: 12.5px; color: #c9ccd6; font-weight: 600; }\n.px-edc { display: flex; align-items: center; gap: 8px; justify-content: flex-end; }\n.px-edc input[type=color] { width: 36px; height: 26px; border: 0; padding: 0; background: none; cursor: pointer; }\n.px-edc input[type=range] { width: 120px; accent-color: var(--pa); } .px-edc b { min-width: 40px; text-align: right; color: #fff; font-size: 12px; }\n.px-cloudlist { display: grid; gap: 10px; }\n.px-cloudgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }\n.px-cloudp { display: grid; gap: 4px; padding: 8px; border-radius: 12px; background: #ffffff08; border: 1px solid #ffffff10; font-size: 12px; }\n.px-cloudp b { color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } .px-cloudp small { color: #8b8f9c; }\n.px-cloudthumb { height: 86px; border: 0; border-radius: 9px; padding: 0; cursor: pointer; display: grid; place-items: center; overflow: hidden; background: repeating-conic-gradient(#ffffff0d 0 25%, transparent 0 50%) 0 0 / 12px 12px, #0005; color: #8b8f9c; }\n.px-cloudthumb img { max-width: 100%; max-height: 100%; image-rendering: pixelated; }\n.px-cloudthumb:hover { box-shadow: inset 0 0 0 2px var(--pa); }\n.px-err { color: #ffb4bb !important; }\n#yapstudio-pixel.px-compact .px-top { padding: 3px 8px; } #yapstudio-pixel.px-compact .px-optbar { min-height: 34px; padding: 3px 10px; }\n#yapstudio-pixel.px-compact .px-tools { grid-template-columns: repeat(2, 29px); gap: 2px; } #yapstudio-pixel.px-compact .px-tool { width: 29px; height: 29px; }\n#yapstudio-pixel.px-compact .px-body { grid-template-columns: 70px minmax(0, 1fr) 280px; } #yapstudio-pixel.px-compact .px-panel { padding: 8px 10px 10px; } #yapstudio-pixel.px-compact .px-side { gap: 6px; padding: 6px; }\n#yapstudio-pixel.px-left .px-body { grid-template-columns: 300px minmax(0, 1fr) 82px; }\n#yapstudio-pixel.px-left.px-compact .px-body { grid-template-columns: 280px minmax(0, 1fr) 70px; }\n#yapstudio-pixel.px-left .px-side { order: 0; border-left: 0; border-right: 1px solid var(--pl); } #yapstudio-pixel.px-left .px-stage { order: 1; } #yapstudio-pixel.px-left .px-tools { order: 2; border-right: 0; border-left: 1px solid var(--pl); }\n#yapstudio-pixel.px-left .px-pill { right: auto; left: 12px; }\n#yapstudio-pixel.px-nostatus .px-status { display: none; }\n/* focus mode (Tab) */\n#yapstudio-pixel.px-zen .px-optbar, #yapstudio-pixel.px-zen .px-tools, #yapstudio-pixel.px-zen .px-side, #yapstudio-pixel.px-zen .px-timeline { display: none; }\n#yapstudio-pixel.px-zen .px-body { grid-template-columns: minmax(0, 1fr); }\n@media (max-width: 1400px) { .px-savestate { display: none; } .px-close span { display: none; } }\n@media (max-width: 1250px) { .px-ohint { display: none; } #yapstudio-pixel .px-name { width: 120px; } }\n@media (max-width: 1100px) { .px-fps { display: none; } .px-body { grid-template-columns: 82px minmax(0, 1fr) 270px; } .px-btn span { display: none; } .px-export span { display: inline; } }\n@media (max-width: 900px) { .px-body, #yapstudio-pixel.px-compact .px-body { grid-template-columns: 82px minmax(0, 1fr); } #yapstudio-pixel.px-left .px-body { grid-template-columns: minmax(0, 1fr) 82px; } .px-side { display: none; } .px-keys { grid-template-columns: auto 1fr; } }\n/* ---- icon + loading screen ---- */\n.ys-icon-img { display: block; image-rendering: pixelated; }\n#yapstudio-nav-button .ys-icon-img { display: inline-block; vertical-align: -3px; }\n#yapstudio-quick header .ys-icon-img { display: inline-block; vertical-align: -3px; }\n.ys-logo:has(.ys-icon-img), .ys-cr-logo:has(.ys-icon-img) { background: none !important; box-shadow: none !important; padding: 0; animation: none; }\n.ys-cr-logo .ys-icon-img { filter: drop-shadow(0 10px 22px color-mix(in srgb, var(--ys-accent) 45%, transparent)); }\n#yapstudio-splash { position: fixed; inset: 0; z-index: 2147483400; display: grid; place-items: center; cursor: pointer; overflow: hidden; color: #f1f1f3;\n  background: radial-gradient(70% 60% at 50% 45%, #1c1d24, #0a0b0e 75%); font-family: "Segoe UI", system-ui, sans-serif; animation: ys-sp-in .35s steps(4) both; }\n#yapstudio-splash.out { animation: ys-sp-out .4s steps(5) forwards; }\n@keyframes ys-sp-in { from { opacity: 0; } to { opacity: 1; } }\n@keyframes ys-sp-out { to { opacity: 0; transform: translateY(-3%); } }\n.ys-sp-grid { position: absolute; inset: 0; pointer-events: none; opacity: .5;\n  background: linear-gradient(#ffffff06 1px, transparent 1px) 0 0 / 24px 24px, linear-gradient(90deg, #ffffff06 1px, transparent 1px) 0 0 / 24px 24px;\n  -webkit-mask: radial-gradient(60% 55% at 50% 45%, #000, transparent); mask: radial-gradient(60% 55% at 50% 45%, #000, transparent); }\n.ys-sp-stars { position: absolute; inset: 0; pointer-events: none; }\n.ys-sp-stars i { position: absolute; width: 3px; height: 3px; background: #fff; opacity: .15; animation: ys-sp-twinkle 2s steps(3) infinite; }\n.ys-sp-stars i:nth-child(3n) { width: 4px; height: 4px; }\n@keyframes ys-sp-twinkle { 0%, 100% { opacity: .1; } 50% { opacity: .85; } }\n.ys-sp-center { position: relative; display: grid; justify-items: center; }\n.ys-sp-hello { margin-bottom: 26px; font: 700 13px/1 Consolas, "Courier New", monospace; letter-spacing: .12em; color: #c9ccd6; animation: ys-sp-rise .4s steps(4) .2s both; }\n.ys-sp-logos { display: flex; align-items: center; gap: 22px; }\n.ys-sp-tile { width: 128px; height: 128px; display: grid; place-items: center; background: #15161b; box-shadow: 0 0 0 3px #000, 0 0 0 6px #2c2d35, 0 0 0 9px #000, 9px 9px 0 6px #0008; }\n.ys-sp-ypp { animation: ys-sp-left .5s steps(5) .1s both, ys-sp-bob 1.6s steps(2) 1s infinite; }\n.ys-sp-ys { box-shadow: 0 0 0 3px #000, 0 0 0 6px var(--sp-a), 0 0 0 9px #000, 9px 9px 0 6px #0008; animation: ys-sp-right .5s steps(5) .1s both, ys-sp-bob 1.6s steps(2) 1.8s infinite; }\n@keyframes ys-sp-bob { 50% { transform: translateY(-4px); } }\n#yapstudio-splash.hop .ys-sp-tile { animation: ys-sp-hop .45s steps(4); }\n@keyframes ys-sp-hop { 40% { transform: translateY(-16px); } 70% { transform: translateY(2px); } }\n.ys-sp-ypp img { width: 112px; height: 112px; object-fit: contain; }\n.ys-sp-ypp b { font-size: 30px; font-weight: 900; }\n.ys-sp-ys img { width: 104px; height: 104px; image-rendering: pixelated; }\n@keyframes ys-sp-left { from { transform: translateX(-160px); opacity: 0; } to { transform: none; opacity: 1; } }\n@keyframes ys-sp-right { from { transform: translateX(160px); opacity: 0; } to { transform: none; opacity: 1; } }\n.ys-sp-x { color: var(--sp-a); animation: ys-sp-pop .35s steps(3) .55s both; filter: drop-shadow(3px 3px 0 #000); }\n.ys-sp-x svg { display: block; animation: ys-sp-pulse 1.2s steps(2) 1.2s infinite; }\n@keyframes ys-sp-pop { from { transform: scale(0); } 60% { transform: scale(1.4); } to { transform: none; } }\n@keyframes ys-sp-pulse { 50% { transform: scale(1.18); } }\n.ys-sp-title { display: flex; align-items: center; gap: 14px; margin-top: 34px; font: 800 22px/1 Consolas, "Courier New", monospace; letter-spacing: .14em; animation: ys-sp-rise .4s steps(4) .65s both; }\n.ys-sp-title span { color: var(--sp-a); }\n#yapstudio-splash.ready .ys-sp-title b { color: var(--sp-a); transition: color .1s steps(1); }\n.ys-sp-sub { margin-top: 10px; font: 700 12px/1 Consolas, "Courier New", monospace; letter-spacing: .14em; color: #8d909b; text-transform: uppercase; animation: ys-sp-rise .4s steps(4) .75s both; }\n@keyframes ys-sp-rise { from { transform: translateY(10px); opacity: 0; } to { transform: none; opacity: 1; } }\n.ys-sp-barrow { display: flex; align-items: center; gap: 12px; margin-top: 30px; animation: ys-sp-rise .3s steps(3) .8s both; }\n.ys-sp-bar { display: flex; gap: 3px; padding: 3px; background: #000; box-shadow: 0 0 0 2px #2c2d35; }\n.ys-sp-bar i { width: 16px; height: 10px; background: #24252c; }\n.ys-sp-bar i.on { background: var(--sp-a); box-shadow: inset 0 -3px 0 #0005; }\n.ys-sp-pct { width: 40px; font: 800 13px/1 Consolas, "Courier New", monospace; color: #fff; text-align: right; }\n.ys-sp-step { height: 14px; margin-top: 12px; font: 700 11.5px/1 Consolas, "Courier New", monospace; letter-spacing: .1em; color: #b4b7c1; }\n#yapstudio-splash.ready .ys-sp-step { color: var(--sp-a); }\n.ys-sp-tip { display: flex; align-items: center; gap: 10px; margin-top: 34px; min-height: 34px; max-width: min(560px, 90vw); padding: 8px 14px 8px 8px; background: #15161b; box-shadow: 0 0 0 2px #000, 0 0 0 4px #2c2d35, 6px 6px 0 2px #0007; animation: ys-sp-rise .4s steps(4) 1s both; }\n.ys-sp-tip b { flex: none; font: 800 10px/1 Consolas, "Courier New", monospace; letter-spacing: .1em; padding: 4px 6px 3px; color: #0b0b0d; background: var(--sp-a); }\n.ys-sp-tip span { font: 600 12.5px/1.35 Consolas, "Courier New", monospace; color: #dfe1e8; }\n.ys-sp-tip span::after { content: "_"; color: var(--sp-a); animation: ys-sp-caret .8s steps(1) infinite; }\n@keyframes ys-sp-caret { 50% { opacity: 0; } }\n.ys-sp-spark { position: fixed; width: 8px; height: 8px; margin: -4px 0 0 -4px; background: #fff; box-shadow: 0 0 0 2px #000; pointer-events: none; animation: ys-sp-fly .75s steps(6) forwards; }\n@keyframes ys-sp-fly { to { transform: translate(var(--dx), var(--dy)); opacity: 0; } }\n.ys-sp-skip { position: absolute; bottom: 26px; font: 700 10.5px/1 Consolas, "Courier New", monospace; letter-spacing: .14em; text-transform: uppercase; color: #5d606b; }\n@media (max-width: 560px) { .ys-sp-tile { width: 92px; height: 92px; } .ys-sp-ypp img { width: 80px; height: 80px; } .ys-sp-ys img { width: 74px; height: 74px; } .ys-sp-title { font-size: 15px; } }\n/* ---- Side Chat page ---- */\n.ys-sc-hero { display: grid; grid-template-columns: auto 1fr; gap: 22px; align-items: center; padding: 20px 22px; border-radius: 18px; margin-bottom: 12px;\n  background: radial-gradient(120% 140% at 0% 0%, color-mix(in srgb, var(--ys-accent) 20%, transparent), transparent 55%), var(--ys-card); border: 1px solid color-mix(in srgb, var(--ys-accent) 32%, var(--ys-line)); }\n.ys-sc-title { font-size: 20px; font-weight: 900; color: #fff; margin-bottom: 4px; }\n.ys-sc-art { position: relative; width: 132px; height: 96px; }\n.ys-sc-art > div { position: absolute; border-radius: 10px; background: #0005; border: 1.5px solid #ffffff2a; padding: 9px; display: grid; gap: 6px; align-content: start; }\n.ys-sc-art .w1 { inset: 0 34px 14px 0; }\n.ys-sc-art .w2 { inset: 30px 0 0 58px; background: color-mix(in srgb, var(--ys-accent) 20%, #15161b); border-color: var(--ys-accent); box-shadow: 0 10px 26px #0008, 0 0 20px color-mix(in srgb, var(--ys-accent) 35%, transparent); animation: ys-float 3.2s ease-in-out infinite; }\n.ys-sc-art i { display: block; height: 6px; border-radius: 4px; background: #ffffff30; }\n.ys-sc-art i:nth-child(2) { width: 70%; } .ys-sc-art i:nth-child(3) { width: 45%; }\n.ys-sc-art .w2 i { background: color-mix(in srgb, var(--ys-accent) 60%, #fff); }\n.ys-sc-how { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 10px; margin-bottom: 14px; }\n.ys-sc-step { display: flex; gap: 12px; align-items: flex-start; padding: 13px 14px; border-radius: 14px; background: var(--ys-card); border: 1px solid var(--ys-line); }\n.ys-sc-step > b { width: 26px; height: 26px; flex: none; border-radius: 8px; display: grid; place-items: center; font-size: 13px; color: #fff; background: linear-gradient(135deg, var(--ys-accent), var(--ys-accent2)); box-shadow: 0 4px 12px color-mix(in srgb, var(--ys-accent) 40%, transparent); }\n.ys-sc-pins { display: grid; gap: 8px; }\n.ys-sc-pin { display: grid; grid-template-columns: auto 1fr auto auto; gap: 12px; align-items: center; padding: 10px 12px; border-radius: 12px; background: var(--ys-card2); border: 1px solid var(--ys-line); }\n.ys-sc-pin.on { border-color: color-mix(in srgb, var(--ys-accent) 50%, transparent); }\n.ys-sc-pin img, .ys-sc-pin .ys-dock-mono { width: 34px; height: 34px; border-radius: 10px; object-fit: cover; }\n.ys-sc-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 6px; margin-top: 8px; }\n.ys-sc-item { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 7px 10px; border-radius: 9px; background: var(--ys-card2); border: 1px solid var(--ys-line); font-size: 12.5px; color: var(--ys-text); }\n.ys-sc-item code { color: var(--ys-accent); font: 700 12px Consolas, monospace; }\n.ys-sc-item span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n/* ---- Side Chat window ---- */\n#yapstudio-dock { position: fixed; z-index: 2147482000; display: flex; flex-direction: column; border-radius: 16px; overflow: hidden; min-width: 300px; min-height: 320px;\n  background: #15161b; border: 1px solid #ffffff1f; box-shadow: 0 24px 70px #000c, 0 0 0 1px #00000080, 0 0 40px color-mix(in srgb, var(--accent, #e27ed3) 18%, transparent);\n  animation: ys-dock-in .35s cubic-bezier(.34,1.4,.64,1) both; font: 13px Inter, "Segoe UI", system-ui, sans-serif; color: #e8e9ee; }\n@keyframes ys-dock-in { from { opacity: 0; transform: translateY(18px) scale(.96); } to { opacity: 1; transform: none; } }\n#yapstudio-dock.min { display: none; }\n#yapstudio-dock.gliding { transition: left .35s cubic-bezier(.34,1.2,.64,1), top .35s; }\n#yapstudio-dock.dragging .ys-dock-frame { pointer-events: none; }\n#yapstudio-dock.dragging { box-shadow: 0 30px 90px #000d, 0 0 0 2px color-mix(in srgb, var(--accent, #e27ed3) 70%, transparent); }\n.ys-dock-head { display: flex; align-items: center; gap: 8px; padding: 7px 8px 7px 12px; cursor: grab; user-select: none; flex: none;\n  background: linear-gradient(180deg, #23242c, #1b1c22); border-bottom: 1px solid #ffffff14; }\n.ys-dock-head:active { cursor: grabbing; }\n.ys-dock-brand { color: var(--accent, #e27ed3); display: grid; place-items: center; filter: drop-shadow(0 0 6px color-mix(in srgb, var(--accent, #e27ed3) 60%, transparent)); }\n.ys-dock-tabs { flex: 1; min-width: 0; display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none; }\n.ys-dock-tabs::-webkit-scrollbar { display: none; }\n.ys-dock-tab { display: flex; align-items: center; gap: 6px; max-width: 160px; padding: 4px 6px 4px 4px; border-radius: 9px; border: 1px solid transparent; background: #ffffff0a; color: #b9bcc8; cursor: pointer; font-weight: 600; font-size: 12px; line-height: 1; font-family: inherit; flex: none; transition: background .15s, color .15s, border-color .15s; }\n.ys-dock-tab:hover { background: #ffffff14; color: #fff; }\n.ys-dock-tab.on { color: #fff; background: color-mix(in srgb, var(--accent, #e27ed3) 22%, #ffffff08); border-color: color-mix(in srgb, var(--accent, #e27ed3) 55%, transparent); box-shadow: 0 0 12px color-mix(in srgb, var(--accent, #e27ed3) 25%, transparent); }\n.ys-dock-tab img, .ys-dock-mono { width: 20px; height: 20px; border-radius: 6px; object-fit: cover; flex: none; }\n.ys-dock-mono { display: grid; place-items: center; font-weight: 900; font-size: 11px; color: #fff; background: linear-gradient(135deg, var(--accent, #e27ed3), #7b61ff); }\n.ys-dock-tab-name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.ys-dock-tab-x { display: grid; place-items: center; width: 16px; height: 16px; border-radius: 5px; opacity: 0; color: #c9ccd6; transition: opacity .12s, background .12s; }\n.ys-dock-tab:hover .ys-dock-tab-x { opacity: 1; }\n.ys-dock-tab-x:hover { background: #ff4b5c33; color: #ff8a95; }\n.ys-dock-add { display: flex; align-items: center; gap: 6px; padding: 5px 8px; border-radius: 9px; border: 1px dashed #ffffff30; background: none; color: #b9bcc8; cursor: pointer; font-weight: 700; font-size: 12px; line-height: 1; font-family: inherit; flex: none; }\n.ys-dock-add:hover { color: #fff; border-color: var(--accent, #e27ed3); background: color-mix(in srgb, var(--accent, #e27ed3) 12%, transparent); }\n.ys-dock-tools { display: flex; gap: 2px; flex: none; }\n.ys-dock-btn { width: 28px; height: 28px; display: grid; place-items: center; border-radius: 8px; border: 0; background: none; color: #a9adba; cursor: pointer; transition: background .12s, color .12s; }\n.ys-dock-btn:hover { background: #ffffff14; color: #fff; }\n.ys-dock-btn:last-child:hover { background: #ff4b5c2e; color: #ff7a87; }\n.ys-dock-body { position: relative; flex: 1; min-height: 0; }\n.ys-dock-frame { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; background: #1b1c21; }\n.ys-dock-veil { position: absolute; inset: 0; display: none; flex-direction: column; align-items: center; justify-content: center; gap: 14px; padding: 24px; text-align: center;\n  background: radial-gradient(circle at 50% 40%, #23242c, #15161b); color: #c9ccd6; font-weight: 600; }\n.ys-dock-veil.show { display: flex; }\n.ys-dock-veil.err span { color: #ffb4bb; max-width: 300px; }\n.ys-dock-veil .ys-btn { font-size: 12.5px; }\n.ys-spin { width: 34px; height: 34px; border-radius: 50%; border: 3px solid #ffffff1a; border-top-color: var(--accent, #e27ed3); animation: ys-spin .8s linear infinite; }\n.ys-dock-grip { position: absolute; right: 0; bottom: 0; width: 18px; height: 18px; cursor: nwse-resize; z-index: 2;\n  background: linear-gradient(135deg, transparent 50%, #ffffff40 50%, #ffffff40 58%, transparent 58%, transparent 70%, #ffffff40 70%, #ffffff40 78%, transparent 78%); }\n#yapstudio-dock-bubble { position: fixed; right: 22px; bottom: 96px; z-index: 2147482000; width: 56px; height: 56px; border-radius: 18px; border: 2px solid color-mix(in srgb, var(--accent, #e27ed3) 70%, transparent);\n  background: #1b1c22; color: var(--accent, #e27ed3); display: grid; place-items: center; cursor: pointer; padding: 0; box-shadow: 0 12px 30px #000a, 0 0 22px color-mix(in srgb, var(--accent, #e27ed3) 30%, transparent);\n  animation: ys-un-pop .4s cubic-bezier(.34,1.8,.64,1) both; transition: transform .15s; }\n#yapstudio-dock-bubble:hover { transform: translateY(-3px) scale(1.04); }\n#yapstudio-dock-bubble img { width: 100%; height: 100%; border-radius: 16px; object-fit: cover; }\n#yapstudio-dock-bubble span { position: absolute; top: -7px; right: -7px; min-width: 22px; height: 22px; padding: 0 6px; border-radius: 11px; background: #f23f43; color: #fff; font: 800 11.5px/22px Inter, "Segoe UI", sans-serif; box-shadow: 0 0 0 3px #15161b; }\n#yapstudio-dock-bubble.ping { animation: ys-bubble-ping 1.6s ease-in-out infinite; }\n@keyframes ys-bubble-ping { 0%, 100% { box-shadow: 0 12px 30px #000a, 0 0 0 0 color-mix(in srgb, var(--accent, #e27ed3) 60%, transparent); } 50% { box-shadow: 0 12px 30px #000a, 0 0 0 9px transparent; } }\n#yapstudio-dock-pin svg { display: block; }\n#yapstudio-dock-pin:hover { color: var(--accent) !important; }\n/* ---- sticky notes ---- */\n.ys-sticky { position: fixed; z-index: 2147481500; width: 220px; border-radius: 4px 4px 14px 4px; background: var(--nc); color: #2b2a22; box-shadow: 0 14px 30px #0008, inset 0 -18px 30px #00000010;\n  animation: ys-un-pop .35s cubic-bezier(.34,1.6,.64,1) both; font: 14px/1.45 "Segoe Print", "Comic Sans MS", system-ui, sans-serif; }\n.ys-sticky.drag { box-shadow: 0 22px 46px #000a; opacity: .92; }\n.ys-sticky-head { display: flex; align-items: center; justify-content: space-between; padding: 6px 6px 4px 8px; cursor: grab; background: #0000000d; border-radius: 4px 4px 0 0; }\n.ys-sticky-cols { display: flex; gap: 4px; opacity: 0; transition: opacity .15s; }\n.ys-sticky:hover .ys-sticky-cols { opacity: 1; }\n.ys-sticky-col { width: 13px; height: 13px; border-radius: 50%; border: 1.5px solid #0003; cursor: pointer; padding: 0; }\n.ys-sticky-x { width: 22px; height: 22px; display: grid; place-items: center; border: 0; border-radius: 6px; background: none; color: #0007; cursor: pointer; }\n.ys-sticky-x:hover { background: #0000001a; color: #000; }\n.ys-sticky textarea { display: block; width: 100%; min-height: 120px; padding: 4px 12px 12px; border: 0; outline: 0; resize: vertical; background: transparent; color: inherit; font: inherit; }\n.ys-sticky textarea::placeholder { color: #0006; }\n/* ---- focus timer ---- */\n#yapstudio-timer { position: fixed; top: 34px; right: 360px; z-index: 2147482100; width: 210px; cursor: grab; user-select: none; color: #fff; font-family: Inter, "Segoe UI", system-ui, sans-serif; --tc: #ff6b4a;\n  animation: ys-ck-in .35s cubic-bezier(.34,1.4,.64,1) both; }\n#yapstudio-timer.drag { cursor: grabbing; opacity: .92; }\n.ys-tmr-top { display: flex; align-items: center; justify-content: space-between; }\n.ys-tmr-phase { font-size: 10.5px; font-weight: 900; letter-spacing: .14em; text-transform: uppercase; color: var(--tc); }\n.ys-tmr-dots { display: flex; gap: 4px; }\n.ys-tmr-dots i { width: 7px; height: 7px; border-radius: 50%; background: #ffffff1f; }\n.ys-tmr-dots i.on { background: var(--tc); }\n.ys-tmr-time { font-size: 34px; font-weight: 800; line-height: 1; letter-spacing: -.02em; font-variant-numeric: tabular-nums; margin: 6px 0 9px; }\n.ys-tmr-bar { height: 4px; border-radius: 99px; background: #ffffff14; overflow: hidden; }\n.ys-tmr-bar i { display: block; height: 100%; background: var(--tc); transition: width .5s linear; }\n.ys-tmr-foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 10px; }\n.ys-tmr-count { font-size: 11px; font-weight: 700; color: #ffffff80; white-space: nowrap; }\n.ys-tmr-btns { display: flex; gap: 4px; }\n.ys-tmr-btn { width: 28px; height: 28px; display: grid; place-items: ce