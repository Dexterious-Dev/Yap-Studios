e); }\n.ys-px-thumb { height: 120px; border-radius: 10px; border: 0; padding: 0; cursor: pointer; display: grid; place-items: center; overflow: hidden; background: repeating-conic-gradient(#ffffff0d 0 25%, transparent 0 50%) 0 0 / 14px 14px, #0005; }\n.ys-px-thumb img { max-width: 100%; max-height: 100%; image-rendering: pixelated; }\n.ys-px-thumb:hover { box-shadow: inset 0 0 0 2px var(--ys-accent); }\n.ys-plus-list { display: grid; gap: 8px; }\n.ys-plus-item { display: grid; gap: 2px; padding: 10px 12px; border-radius: 12px; background: var(--ys-card2, #2a2b32); border: 1px solid var(--ys-line, #ffffff14); }\n.ys-plus-item b { font-size: 13px; } .ys-plus-item span { font-size: 12px; color: var(--ys-mut, #9ea3ae); line-height: 1.4; }\n.ys-feat-styles { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 8px; margin-top: 12px; }\n.ys-feat-style { display: grid; gap: 4px; padding: 10px 12px; border-radius: 12px; background: var(--ys-card2, #2a2b32); border: 1px solid var(--ys-line, #ffffff14); min-width: 0; }\n.ys-feat-style small { font-size: 10.5px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--ys-mut, #9ea3ae); }\n.ys-feat-sample { font-size: 15px; overflow-wrap: anywhere; color: var(--ys-text, #eee); }\n.ys-feat-sbtns { display: flex; gap: 6px; } .ys-feat-sbtns .ys-btn { padding: 4px 10px; font-size: 12px; }\n.ys-feat-fields { display: grid; gap: 8px; margin: 10px 0; }\n.ys-feat-field { display: grid; gap: 4px; font-size: 12px; font-weight: 700; color: var(--ys-mut, #9ea3ae); }\n.ys-feat-out { margin: 0 0 10px; padding: 12px; border-radius: 10px; background: #0d0e12; color: #fff; font: 13px/1.5 Consolas, monospace; white-space: pre-wrap; overflow-wrap: anywhere; max-height: 260px; overflow: auto; }\n.ys-feat-out.bad { color: #ffb4bb; }\n.ys-feat-toolsel { min-width: 220px; }\n.ys-feat-syms { display: grid; grid-template-columns: repeat(auto-fill, minmax(44px, 1fr)); gap: 5px; margin-top: 10px; }\n.y