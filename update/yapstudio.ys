{ display: block; height: 100%; border-radius: 999px; background: linear-gradient(90deg, var(--ys-accent), var(--ys-accent2)); transition: width .4s; }\n/* ---- achievements ---- */\n.ys-ah { position: relative; overflow: hidden; display: grid; grid-template-columns: auto 1fr auto; gap: 26px; align-items: center; padding: 24px 26px; border-radius: 20px; margin-bottom: 12px;\n  background: linear-gradient(160deg, color-mix(in srgb, var(--ys-card) 92%, #fff 0%), color-mix(in srgb, var(--ys-card) 80%, #000)); border: 1px solid color-mix(in srgb, var(--ys-accent) 28%, var(--ys-line)); box-shadow: 0 20px 50px #0007, inset 0 1px 0 #ffffff12; }\n.ys-ah-glow { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(60% 120% at 0% 0%, color-mix(in srgb, var(--ys-accent) 24%, transparent), transparent 60%), radial-gradient(50% 100% at 100% 100%, color-mix(in srgb, var(--ys-accent2) 14%, transparent), transparent 65%); }\n.ys-ah > *:not(.ys-ah-glow) { position: relative; }\n.ys-ah-ring { width: 132px; height: 132px; display: grid; place-items: center; }\n.ys-ah-ring svg { position: absolute; inset: 0; width: 100%; height: 100%; transform: rotate(-90deg); }\n.ys-ah-ring line { stroke: #ffffff18; stroke-width: 2; stroke-linecap: round; }\n.ys-ah-ring line.on { stroke: var(--ys-accent); }\n.ys-ah-ring circle { fill: none; stroke-width: 7; }\n.ys-ah-ring .bg { stroke: #ffffff0f; }\n.ys-ah-ring .fg { stroke: url(#ysAhGrad); stroke-linecap: round; filter: drop-shadow(0 0 6px color-mix(in srgb, var(--ys-accent) 60%, transparent)); }\n.ys-ah-ring > div { display: grid; justify-items: center; line-height: 1; }\n.ys-ah-ring small { font-size: 9.5px; font-weight: 800; letter-spacing: .18em; color: var(--ys-faint); }\n.ys-ah-ring b { font-size: 42px; font-weight: 900; color: #fff; margin: 3px 0 2px; }\n.ys-ah-ring span { font-size: 10.5px; font-weight: 800; color: var(--ys-accent); }\n.ys-ah-kicker { font-size: 10.5px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; color: var(--ys-accent); }\n.ys-ah-title { font-size: 26px; font-weight: 900; color: #fff; letter-spacing: -.02em; margin: 2px 0 2px; }\n.ys-ah-sub { font-size: 13px; color: var(--ys-mut); }\n.ys-ah-bar { height: 8px; border-radius: 99px; background: #0006; border: 1px solid #ffffff12; overflow: hidden; margin: 14px 0 7px; }\n.ys-ah-bar i { display: block; height: 100%; border-radius: 99px; background: linear-gradient(90deg, var(--ys-accent), var(--ys-accent2)); box-shadow: 0 0 12px color-mix(in srgb, var(--ys-accent) 70%, transparent); }\n.ys-ah-ends { display: flex; justify-content: space-between; font-size: 11px; font-weight: 700; color: var(--ys-faint); }\n.ys-ah-next { display: grid; justify-items: center; gap: 5px; min-width: 150px; padding: 16px 18px; border-radius: 16px; background: #0003; border: 1px solid #ffffff12; text-align: center; }\n.ys-ah-next small { font-size: 9.5px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; color: var(--ys-faint); }\n.ys-ah-next img { width: 46px; height: 46px; image-rendering: pixelated; filter: drop-shadow(0 4px 10px #0008); }\n.ys-ah-next b { font-size: 13.5px; color: #fff; }\n.ys-ah-next span { font-size: 11.5px; color: var(--ys-mut); }\n.ys-sw4 { display: flex; width: 30px; height: 22px; border-radius: 6px; overflow: hidden; border: 1px solid #ffffff26; }\n.ys-sw4.big { width: 48px; height: 32px; border-radius: 8px; }\n.ys-sw4 i { flex: 1; }\n.ys-ats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; margin-bottom: 18px; }\n.ys-at { display: grid; gap: 2px; padding: 14px 16px; border-radius: 14px; background: var(--ys-card); border: 1px solid var(--ys-line); }\n.ys-at b { font-size: 20px; font-weight: 900; color: #fff; letter-spacing: -.01em; }\n.ys-at span { font-size: 11px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--ys-mut); }\n.ys-at small { font-size: 11.5px; color: var(--ys-faint); }\n.ys-at.r-legendary b { color: #ffd76a; } .ys-at.r-epic b { color: #e39bff; } .ys-at.r-rare b { color: #7fc8ff; }\n@media (max-width: 900px) { .ys-ats { grid-template-columns: repeat(2, minmax(0, 1fr)); } .ys-ah { grid-template-columns: auto 1fr; } .ys-ah-next { display: none; } }\n.ys-asec { margin-bottom: 18px; }\n.ys-asec-h { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin: 0 2px 10px; }\n.ys-asec-h span { font-size: 12px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--ys-text); }\n.ys-asec-h small { font-size: 11.5px; color: var(--ys-faint); font-weight: 700; }\n.ys-arecent { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px; }\n.ys-arc { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: 14px; background: linear-gradient(135deg, color-mix(in srgb, var(--r1) 14%, var(--ys-card)), var(--ys-card)); border: 1px solid color-mix(in srgb, var(--r1) 40%, transparent); }\n.ys-arc-icon { width: 42px; height: 42px; flex: none; border-radius: 11px; display: grid; place-items: center; background: color-mix(in srgb, var(--r1) 22%, #0004); }\n.ys-arc-icon img { width: 30px; height: 30px; image-rendering: pixelated; }\n.ys-arc b { display: block; font-size: 13px; color: #fff; }\n.ys-arc span { font-size: 11px; color: var(--r2); font-weight: 700; }\n.ys-track { position: relative; padding: 16px 18px 12px; border-radius: 16px; background: var(--ys-card); border: 1px solid var(--ys-line); }\n.ys-track-line { position: absolute; left: 38px; right: 38px; top: 36px; height: 4px; border-radius: 99px; background: #ffffff12; }\n.ys-track-line i { display: block; height: 100%; border-radius: 99px; background: linear-gradient(90deg, var(--ys-accent), var(--ys-accent2)); box-shadow: 0 0 10px color-mix(in srgb, var(--ys-accent) 60%, transparent); }\n.ys-track-stops { position: relative; display: grid; grid-template-columns: repeat(10, 1fr); }\n.ys-stop { display: grid; justify-items: center; gap: 7px; text-align: center; }\n.ys-stop-dot { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: var(--ys-card2); border: 2px solid #ffffff1c; color: var(--ys-faint); font-size: 13px; transition: transform .15s; }\n.ys-stop-dot img { width: 24px; height: 24px; image-rendering: pixelated; filter: grayscale(1) brightness(.6); }\n.ys-stop-dot .ys-sw4 { width: 22px; height: 16px; filter: grayscale(1); }\n.ys-stop span { font-size: 10.5px; font-weight: 700; color: var(--ys-faint); line-height: 1.2; max-width: 74px; }\n.ys-stop.done .ys-stop-dot { border-color: var(--ys-accent); color: #fff; background: color-mix(in srgb, var(--ys-accent) 22%, var(--ys-card2)); }\n.ys-stop.done .ys-stop-dot img, .ys-stop.done .ys-stop-dot .ys-sw4 { filter: none; }\n.ys-stop.done span { color: var(--ys-mut); }\n.ys-stop.reward .ys-stop-dot { border-radius: 12px; }\n.ys-stop.here .ys-stop-dot { transform: scale(1.12); box-shadow: 0 0 0 4px color-mix(in srgb, var(--ys-accent) 25%, transparent), 0 0 18px color-mix(in srgb, var(--ys-accent) 45%, transparent); }\n.ys-stop.here span { color: #fff; }\n.ys-atool { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; margin-bottom: 6px; }\n.ys-atool-r { display: flex; gap: 8px; align-items: center; }\n.ys-asearch-box { display: flex; align-items: center; gap: 7px; padding: 0 11px; border-radius: 10px; background: var(--ys-card); border: 1px solid var(--ys-line2); color: var(--ys-faint); }\n.ys-asearch-box:focus-within { border-color: var(--ys-accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--ys-accent) 20%, transparent); }\n.ys-asearch { width: 180px; background: none; border: 0; outline: 0; color: var(--ys-text); font: inherit; font-size: 13px; padding: 8px 0; }\n.ys-asort { padding: 8px 10px; }\n.ys-chips { display: flex; flex-wrap: wrap; gap: 6px; }\n.ys-chip { padding: 7px 13px; border-radius: 999px; border: 1px solid var(--ys-line2); background: var(--ys-card); color: var(--ys-mut); font-weight: 700; font-size: 12.5px; line-height: 1; font-family: inherit; cursor: pointer; transition: all .15s; }\n.ys-chip:hover { color: var(--ys-text); border-color: color-mix(in srgb, var(--ys-accent) 45%, var(--ys-line2)); }\n.ys-chip.on { color: #fff; background: linear-gradient(135deg, var(--ys-accent), var(--ys-accent2)); border-color: transparent; box-shadow: 0 4px 14px color-mix(in srgb, var(--ys-accent) 35%, transparent); }\n.ys-acat { display: flex; align-items: center; gap: 12px; margin: 20px 2px 10px; }\n.ys-acat span { font-size: 12px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--ys-text); white-space: nowrap; }\n.ys-acat-bar { flex: 1; height: 4px; border-radius: 99px; background: #ffffff0d; overflow: hidden; }\n.ys-acat-bar i { display: block; height: 100%; border-radius: 99px; background: linear-gradient(90deg, var(--ys-accent), var(--ys-accent2)); }\n.ys-acat small { font-size: 11.5px; font-weight: 800; color: var(--ys-faint); }\n.ys-agrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 10px; }\n.ys-ac { position: relative; display: flex; gap: 14px; padding: 14px 15px 13px; border-radius: 14px; background: var(--ys-card); border: 1px solid var(--ys-line); overflow: hidden; transition: transform .18s cubic-bezier(.2,.8,.2,1), box-shadow .18s, border-color .18s; }\n.ys-ac::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: linear-gradient(var(--r1), var(--r2)); opacity: .35; }\n.ys-ac::after { content: ""; position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity .25s; background: radial-gradient(260px circle at var(--mx, 50%) var(--my, 50%), color-mix(in srgb, var(--r1) 14%, transparent), transparent 60%); }\n.ys-ac:hover { transform: translateY(-2px); border-color: color-mix(in srgb, var(--r1) 40%, var(--ys-line)); box-shadow: 0 12px 28px #0007; }\n.ys-ac:hover::after { opacity: 1; }\n.ys-ac-icon { position: relative; width: 50px; height: 50px; flex: none; border-radius: 13px; display: grid; place-items: center; background: #0004; border: 1px solid #ffffff0f; }\n.ys-ac-icon img { width: 34px; height: 34px; image-rendering: pixelated; filter: grayscale(1) brightness(.45); }\n.ys-ac-icon > b { font-size: 22px; font-weight: 900; color: var(--ys-faint); }\n.ys-ac-check { position: absolute; right: -5px; bottom: -5px; width: 19px; height: 19px; border-radius: 50%; display: grid; place-items: center; color: #10120f; background: linear-gradient(135deg, var(--r1), var(--r2)); box-shadow: 0 0 0 3px var(--ys-card); }\n.ys-ac-body { flex: 1; min-width: 0; display: grid; align-content: start; gap: 3px; }\n.ys-ac-top { display: flex; align-items: center; gap: 8px; }\n.ys-ac-name { font-weight: 800; font-size: 13.5px; color: var(--ys-text); }\n.ys-ac-new { font-size: 9.5px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; color: #fff; padding: 2px 7px; border-radius: 6px; background: linear-gradient(135deg, var(--ys-accent), var(--ys-accent2)); }\n.ys-ac-desc { font-size: 12px; color: var(--ys-mut); line-height: 1.4; }\n.ys-ac-prog { display: flex; align-items: center; gap: 9px; margin-top: 4px; }\n.ys-ac-bar { flex: 1; height: 5px; border-radius: 99px; background: #ffffff0f; overflow: hidden; }\n.ys-ac-bar i { display: block; height: 100%; border-radius: 99px; background: linear-gradient(90deg, var(--r1), var(--r2)); }\n.ys-ac-prog span { font-size: 10.5px; font-weight: 800; color: var(--ys-faint); white-space: nowrap; font-variant-numeric: tabular-nums; }\n.ys-ac-foot { display: flex; align-items: center; gap: 8px; margin-top: 6px; font-size: 10.5px; font-weight: 700; color: var(--ys-faint); }\n.ys-ac-foot > span + span::before { content: ""; display: inline-block; width: 3px; height: 3px; border-radius: 50%; background: currentColor; opacity: .5; margin-right: 8px; vertical-align: middle; }\n.ys-ac-rar { color: var(--r2); text-transform: uppercase; letter-spacing: .08em; font-weight: 900; }\n.ys-ac.on { border-color: color-mix(in srgb, var(--r1) 30%, var(--ys-line)); background: linear-gradient(135deg, color-mix(in srgb, var(--r1) 9%, var(--ys-card)), var(--ys-card) 55%); }\n.ys-ac.on::before { opacity: 1; }\n.ys-ac.on .ys-ac-icon { background: radial-gradient(circle, color-mix(in srgb, var(--r1) 30%, transparent), #0003 75%); border-color: color-mix(in srgb, var(--r1) 45%, transparent); }\n.ys-ac.on .ys-ac-icon img { filter: drop-shadow(0 2px 4px #0008); }\n.ys-ac.r-legendary.on { box-shadow: 0 0 0 1px #ffb02022, 0 8px 26px #ffb02014; }\n.ys-ac.secret .ys-ac-name { color: var(--ys-mut); }\n.ys-ac.secret { background: repeating-linear-gradient(135deg, #ffffff04 0 8px, transparent 8px 16px), var(--ys-card); }\n/* ---- credits ---- */\n.ys-cr-hero { position: relative; overflow: hidden; padding: 30px 30px 24px; border-radius: 22px; margin-bottom: 12px; border: 1px solid color-mix(in srgb, var(--ys-accent) 30%, var(--ys-line)); background: #15161b; box-shadow: 0 24px 60px #0008; }\n.ys-cr-mesh { position: absolute; inset: -40%; pointer-events: none; opacity: .85;\n  background: radial-gradient(35% 45% at 20% 30%, color-mix(in srgb, var(--ys-accent) 45%, transparent), transparent 70%), radial-gradient(30% 40% at 80% 20%, color-mix(in srgb, var(--ys-accent2) 38%, transparent), transparent 70%), radial-gradient(40% 40% at 60% 90%, color-mix(in srgb, var(--ys-accent) 22%, transparent), transparent 70%);\n  animation: ys-cr-drift 18s ease-in-out infinite alternate; }\n@keyframes ys-cr-drift { from { transform: translate(-3%, -2%) scale(1); } to { transform: translate(3%, 2%) scale(1.06); } }\n.ys-cr-hero::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, transparent 40%, #0007), repeating-linear-gradient(0deg, #ffffff05 0 1px, transparent 1px 4px); }\n.ys-cr-hero > *:not(.ys-cr-mesh) { position: relative; z-index: 1; }\n.ys-cr-brand { display: flex; align-items: center; gap: 18px; }\n.ys-cr-logo { width: 68px; height: 68px; border-radius: 20px; display: grid; place-items: center; color: #fff; background: linear-gradient(135deg, var(--ys-accent), var(--ys-accent2)); box-shadow: 0 12px 30px color-mix(in srgb, var(--ys-accent) 45%, transparent), inset 0 1px 0 #ffffff55; }\n.ys-cr-name { display: flex; align-items: center; gap: 10px; font-size: 30px; font-weight: 900; color: #fff; letter-spacing: -.03em; }\n.ys-cr-ver { font-size: 12px; font-weight: 800; letter-spacing: .02em; padding: 4px 9px; border-radius: 999px; color: #fff; background: #ffffff1c; border: 1px solid #ffffff30; backdrop-filter: blur(6px); }\n.ys-cr-tag { font-size: 14px; color: #ffffffb3; margin-top: 3px; }\n.ys-cr-counts { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; margin-top: 24px; }\n.ys-cr-counts div { padding: 12px 14px; border-radius: 14px; background: #00000045; border: 1px solid #ffffff14; backdrop-filter: blur(6px); }\n.ys-cr-counts b { display: block; font-size: 22px; font-weight: 900; color: #fff; }\n.ys-cr-counts span { font-size: 11px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: #ffffff99; }\n@media (max-width: 900px) { .ys-cr-counts { grid-template-columns: repeat(3, minmax(0, 1fr)); } .ys-cr-grid { grid-template-columns: 1fr !important; } }\n.ys-cr-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 12px; margin-bottom: 18px; }\n.ys-cr-creator { display: flex; gap: 18px; align-items: center; padding: 20px; border-radius: 18px; background: linear-gradient(135deg, color-mix(in srgb, var(--ys-accent) 10%, var(--ys-card)), var(--ys-card)); border: 1px solid var(--ys-line); }\n.ys-cr-av { width: 78px; height: 78px; flex: none; border-radius: 50%; padding: 3px; background: conic-gradient(from 200deg, var(--ys-accent), var(--ys-accent2), var(--ys-accent)); box-shadow: 0 10px 26px color-mix(in srgb, var(--ys-accent) 35%, transparent); }\n.ys-cr-av span { width: 100%; height: 100%; border-radius: 50%; display: grid; place-items: center; font-size: 30px; font-weight: 900; color: #fff; background: #1b1c22; }\n.ys-cr-cinfo small { font-size: 10.5px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--ys-accent); }\n.ys-cr-cname { font-size: 22px; font-weight: 900; color: #fff; margin: 1px 0 3px; }\n.ys-cr-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }\n.ys-cr-chips span { font-size: 11px; font-weight: 800; padding: 4px 9px; border-radius: 999px; color: var(--ys-text); background: #ffffff0c; border: 1px solid var(--ys-line2); }\n.ys-cr-privacy { display: flex; gap: 14px; padding: 20px; border-radius: 18px; background: var(--ys-card); border: 1px solid var(--ys-line); }\n.ys-cr-shield { width: 44px; height: 44px; flex: none; border-radius: 13px; display: grid; place-items: center; color: #4ade80; background: #4ade801a; border: 1px solid #4ade8040; }\n.ys-cr-privacy b { display: block; color: #fff; font-size: 14px; margin-bottom: 4px; }\n.ys-cr-sec { margin-bottom: 18px; }\n.ys-cr-h { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; flex-wrap: wrap; margin: 0 2px 10px; }\n.ys-cr-h span { font-size: 12px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--ys-text); }\n.ys-cr-h small { font-size: 11.5px; color: var(--ys-faint); font-weight: 600; }\n.ys-cr-people { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }\n.ys-cr-person { position: relative; overflow: hidden; display: flex; align-items: center; gap: 12px; padding: 14px; border-radius: 15px; background: var(--ys-card); border: 1px solid var(--ys-line); transition: transform .18s, border-color .18s; }\n.ys-cr-person::after { content: ""; position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity .25s; background: radial-gradient(220px circle at var(--mx, 50%) var(--my, 50%), color-mix(in srgb, var(--p1) 16%, transparent), transparent 60%); }\n.ys-cr-person:hover { transform: translateY(-2px); border-color: color-mix(in srgb, var(--p1) 45%, var(--ys-line)); }\n.ys-cr-person:hover::after { opacity: 1; }\n.ys-cr-pav { width: 44px; height: 44px; flex: none; border-radius: 13px; display: grid; place-items: center; font-weight: 900; font-size: 17px; color: #fff; background: linear-gradient(135deg, var(--p1), var(--p2)); box-shadow: 0 6px 16px color-mix(in srgb, var(--p1) 35%, transparent); }\n.ys-cr-pname { font-weight: 800; color: #fff; font-size: 14px; }\n.ys-cr-tl { position: relative; padding: 6px 0 2px; }\n.ys-cr-tl::before { content: ""; position: absolute; left: 11px; top: 12px; bottom: 12px; width: 2px; background: linear-gradient(var(--ys-accent), var(--ys-line2) 30%); border-radius: 2px; }\n.ys-cr-rel { position: relative; display: flex; gap: 16px; padding: 8px 0; }\n.ys-cr-node { width: 24px; flex: none; display: grid; place-items: center; }\n.ys-cr-node::before { content: ""; width: 12px; height: 12px; border-radius: 50%; margin-top: 15px; background: var(--ys-card2); border: 2px solid var(--ys-line2); }\n.ys-cr-rel.now .ys-cr-node::before { background: var(--ys-accent); border-color: color-mix(in srgb, var(--ys-accent) 40%, #fff); box-shadow: 0 0 0 4px color-mix(in srgb, var(--ys-accent) 22%, transparent); }\n.ys-cr-relbody { flex: 1; padding: 11px 14px; border-radius: 12px; background: var(--ys-card); border: 1px solid var(--ys-line); }\n.ys-cr-rel.now .ys-cr-relbody { border-color: color-mix(in srgb, var(--ys-accent) 40%, var(--ys-line)); background: linear-gradient(135deg, color-mix(in srgb, var(--ys-accent) 8%, var(--ys-card)), var(--ys-card)); }\n.ys-cr-reltop { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }\n.ys-cr-relv { font-size: 12px; font-weight: 900; color: var(--ys-accent); font-variant-numeric: tabular-nums; }\n.ys-cr-reltop b { color: #fff; font-size: 13.5px; }\n.ys-cr-cur { font-size: 9.5px; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; padding: 3px 8px; border-radius: 6px; color: #fff; background: linear-gradient(135deg, var(--ys-accent), var(--ys-accent2)); }\n.ys-cr-foot { display: grid; justify-items: center; gap: 4px; padding: 18px 0 8px; text-align: center; font-size: 11.5px; color: var(--ys-faint); }\n.ys-cr-foot span:first-child { font-weight: 800; color: var(--ys-mut); }\n.ys-lock { margin-left: auto; font-size: 9.5px; font-weight: 900; color: #ffd76a; background: #ffc93c1f; border: 1px solid #ffc93c55; padding: 2px 6px; border-radius: 6px; }\n.ys-badge-opt.locked, .ys-preset.locked { opacity: .55; filter: grayscale(.7); }\n.ys-preset.locked .ys-lock { position: absolute; top: 6px; right: 6px; }\n.ys-preset { position: relative; }\n/* the unlock pop-up */\n#yapstudio-unlock { position: fixed; top: 22px; left: 50%; z-index: 2147483200; width: 404px; max-width: calc(100vw - 32px); margin-left: -202px; cursor: pointer;\n  font: 13px/1.3 "Segoe UI", system-ui, sans-serif; color: #f1f1f3; animation: ys-un-in .3s steps(5) both; }\n@media (max-width: 470px) { #yapstudio-unlock { left: 16px; margin-left: 0; } }\n#yapstudio-unlock.out { animation: ys-un-out .24s steps(4) forwards; }\n@keyframes ys-un-in { from { transform: translateY(-130%); } to { transform: none; } }\n@keyframes ys-un-out { to { transform: translateY(-140%); } }\n.ys-un-card { display: flex; align-items: center; gap: 14px; padding: 12px 14px 12px 12px; background: #1a1b20; border: 2px solid #000; box-shadow: inset 0 0 0 2px var(--r1), inset 0 0 0 4px #000, 5px 5px 0 #000a; }\n.ys-un-icon { width: 60px; height: 60px; flex: none; display: grid; place-items: center; color: var(--r2); --ck-px: 6px;\n  background: repeating-conic-gradient(#ffffff08 0 25%, transparent 0 50%) 0 0 / 10px 10px, #0e0f12; box-shadow: inset 0 0 0 2px var(--r1); image-rendering: pixelated; }\n.ys-un-icon img { width: 44px; height: 44px; image-rendering: pixelated; animation: ys-un-bob .5s steps(2) .